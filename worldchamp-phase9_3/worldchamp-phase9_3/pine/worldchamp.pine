// -----------------------------------------------------------------------------
// Phase 9 operating-mode gates
// Production and Validation both hard-disable every TEST override. Production
// hides historical validation clutter. Validation keeps historical markers while
// running the exact Production rules. Debug is the only mode that enables TEST
// overrides and raw diagnostics.
// -----------------------------------------------------------------------------
bool useTestWindow = (validationMode or debugMode) and useTestWindowInput
string locationDirectionMode = testControlsEnabled ? locationDirectionModeInput : "Auto"

bool showHistoricalParticipation = validationVisualsEnabled and showHistoricalParticipationInput
bool showParticipationSessionSummary = debugMode and showParticipationSessionSummaryInput
bool showHistoricalOrderflow = debugMode and showHistoricalOrderflowInput
bool showOrderflowSessionSummary = debugMode and showOrderflowSessionSummaryInput
bool showHistoricalAggression = validationVisualsEnabled and showHistoricalAggressionInput
bool showAggressionSessionSummary = debugMode and showAggressionSessionSummaryInput
bool showHistoricalAbsorption = validationVisualsEnabled and showHistoricalAbsorptionInput
bool showPotentialAbsorption = validationVisualsEnabled and showPotentialAbsorptionInput
bool showAbsorptionSessionSummary = debugMode and showAbsorptionSessionSummaryInput

bool dominanceAllowPotentialTest = testControlsEnabled and dominanceAllowPotentialTestInput
bool dominanceBypassContextTest = testControlsEnabled and dominanceBypassContextTestInput
bool dominanceDiagnosticMode = testControlsEnabled and dominanceDiagnosticModeInput
bool dominanceDiagnosticUseDirectionalDelta = testControlsEnabled and dominanceDiagnosticUseDirectionalDeltaInput
bool dominanceDiagnosticIgnoreMidpoint = testControlsEnabled and dominanceDiagnosticIgnoreMidpointInput
bool showDominanceCandidates = debugMode and showDominanceCandidatesInput
bool showHistoricalDominance = validationVisualsEnabled and showHistoricalDominanceInput
bool showDominanceSessionSummary = debugMode and showDominanceSessionSummaryInput

bool showHistoricalRetest = validationVisualsEnabled and showHistoricalRetestInput
bool showSetupSessionSummary = debugMode and showSetupSessionSummaryInput
bool setupDiagnosticMode = testControlsEnabled and setupDiagnosticModeInput
bool setupDiagnosticUseDirectionalDelta = testControlsEnabled and setupDiagnosticUseDirectionalDeltaInput
bool setupDiagnosticIgnoreRetestTouch = testControlsEnabled and setupDiagnosticIgnoreRetestTouchInput
bool setupDiagnosticBypassLocation = testControlsEnabled and setupDiagnosticBypassLocationInput

// -----------------------------------------------------------------------------
// Chart guards
// -----------------------------------------------------------------------------
int chartSeconds = timeframe.in_seconds(timeframe.period)
int fiveMinSeconds = timeframe.in_seconds("5")
bool isFiveMinute = chartSeconds == fiveMinSeconds

if require5m and chartSeconds != fiveMinSeconds
    runtime.error("WorldChamp Phase 9.1 must run on a 5-minute chart while 'Require 5-minute chart' is enabled.")

int profileLtfSeconds = timeframe.in_seconds(profileLtf)
if profileLtfSeconds >= chartSeconds
    runtime.error("WorldChamp Phase 9.1 requires the profile lower timeframe to be below the chart timeframe.")

// -----------------------------------------------------------------------------
// Development window
// -----------------------------------------------------------------------------
int windowStart = timenow - testDays * MS_DAY
bool inTestWindow = not useTestWindow or time >= windowStart

// -----------------------------------------------------------------------------
// Confirmed higher-timeframe OHLC
// Stable HTF pattern: expression[1] + barmerge.lookahead_on.
// -----------------------------------------------------------------------------
[open4h, high4h, low4h, close4h, time4h] = request.security(
    syminfo.tickerid,
    TF_4H,
    [open[1], high[1], low[1], close[1], time[1]],
    lookahead=barmerge.lookahead_on)

[open1h, high1h, low1h, close1h, time1h] = request.security(
    syminfo.tickerid,
    TF_1H,
    [open[1], high[1], low[1], close[1], time[1]],
    lookahead=barmerge.lookahead_on)

[open15m, high15m, low15m, close15m, time15m] = request.security(
    syminfo.tickerid,
    TF_15M,
    [open[1], high[1], low[1], close[1], time[1]],
    lookahead=barmerge.lookahead_on)

// -----------------------------------------------------------------------------
// Confirmed HTF structure helper
//
// Pivots are confirmed only after `strength` bars have elapsed to the right.
// The returned series are then offset by one HTF bar before lookahead is used,
// favoring stability over speed during this validation phase.
// -----------------------------------------------------------------------------
f_confirmedStructure(int strength) =>
    float ph = ta.pivothigh(high, strength, strength)
    float pl = ta.pivotlow(low, strength, strength)

    float lastHigh = ta.valuewhen(not na(ph), ph, 0)
    float prevHigh = ta.valuewhen(not na(ph), ph, 1)
    float lastLow = ta.valuewhen(not na(pl), pl, 0)
    float prevLow = ta.valuewhen(not na(pl), pl, 1)

    int lastHighTime = ta.valuewhen(not na(ph), time[strength], 0)
    int prevHighTime = ta.valuewhen(not na(ph), time[strength], 1)
    int lastLowTime = ta.valuewhen(not na(pl), time[strength], 0)
    int prevLowTime = ta.valuewhen(not na(pl), time[strength], 1)

    [lastHigh[1], prevHigh[1], lastLow[1], prevLow[1], lastHighTime[1], prevHighTime[1], lastLowTime[1], prevLowTime[1]]

[lastHigh4h, prevHigh4h, lastLow4h, prevLow4h, lastHighTime4h, prevHighTime4h, lastLowTime4h, prevLowTime4h] = request.security(
    syminfo.tickerid,
    TF_4H,
    f_confirmedStructure(pivotLength4h),
    lookahead=barmerge.lookahead_on)

[lastHigh1h, prevHigh1h, lastLow1h, prevLow1h, lastHighTime1h, prevHighTime1h, lastLowTime1h, prevLowTime1h] = request.security(
    syminfo.tickerid,
    TF_1H,
    f_confirmedStructure(pivotLength1h),
    lookahead=barmerge.lookahead_on)

[lastHigh15m, prevHigh15m, lastLow15m, prevLow15m, lastHighTime15m, prevHighTime15m, lastLowTime15m, prevLowTime15m] = request.security(
    syminfo.tickerid,
    TF_15M,
    f_confirmedStructure(pivotLength15m),
    lookahead=barmerge.lookahead_on)

// -----------------------------------------------------------------------------
// Structure classification
// HH + HL = TREND UP.
// LH + LL = TREND DOWN.
// LH + HL = CONTRACTING.
// HH + LL = EXPANDING.
// -----------------------------------------------------------------------------
f_structureCode(float lastHigh, float prevHigh, float lastLow, float prevLow) =>
    int result = STRUCT_WARMING
    if not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow)
        bool higherHigh = lastHigh > prevHigh
        bool lowerHigh = lastHigh < prevHigh
        bool higherLow = lastLow > prevLow
        bool lowerLow = lastLow < prevLow

        result := higherHigh and higherLow ? STRUCT_TREND_UP :
          lowerHigh and lowerLow ? STRUCT_TREND_DOWN :
          lowerHigh and higherLow ? STRUCT_CONTRACTING :
          higherHigh and lowerLow ? STRUCT_EXPANDING : STRUCT_NEUTRAL
    result

int structure4h = f_structureCode(lastHigh4h, prevHigh4h, lastLow4h, prevLow4h)
int structure1h = f_structureCode(lastHigh1h, prevHigh1h, lastLow1h, prevLow1h)

f_structureText(int code) =>
    code == STRUCT_TREND_UP ? "TREND UP" :
     code == STRUCT_TREND_DOWN ? "TREND DOWN" :
     code == STRUCT_CONTRACTING ? "CONTRACTING" :
     code == STRUCT_EXPANDING ? "EXPANDING" :
     code == STRUCT_NEUTRAL ? "NEUTRAL" : "WARMING"

f_structurePattern(float lastHigh, float prevHigh, float lastLow, float prevLow) =>
    string result = "WARMING"
    if not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow)
        string highTag = lastHigh > prevHigh ? "HH" : lastHigh < prevHigh ? "LH" : "EH"
        string lowTag = lastLow > prevLow ? "HL" : lastLow < prevLow ? "LL" : "EL"
        result := highTag + " + " + lowTag
    result

f_structureColor(int code) =>
    code == STRUCT_TREND_UP ? color.lime :
     code == STRUCT_TREND_DOWN ? color.red :
     code == STRUCT_CONTRACTING ? color.aqua :
     code == STRUCT_EXPANDING ? color.orange :
     code == STRUCT_NEUTRAL ? color.silver : color.orange

f_alignmentText(int code4h, int code1h) =>
    string result = "WARMING"
    if code4h != STRUCT_WARMING and code1h != STRUCT_WARMING
        result := code4h == STRUCT_TREND_UP and code1h == STRUCT_TREND_UP ? "ALIGNED UP" :
          code4h == STRUCT_TREND_DOWN and code1h == STRUCT_TREND_DOWN ? "ALIGNED DOWN" :
          code4h == STRUCT_TREND_UP and code1h == STRUCT_TREND_DOWN ? "4H UP / 1H PULLBACK" :
          code4h == STRUCT_TREND_DOWN and code1h == STRUCT_TREND_UP ? "4H DOWN / 1H PULLBACK" :
          code4h == STRUCT_TREND_UP and code1h == STRUCT_CONTRACTING ? "UP / 1H COMPRESSION" :
          code4h == STRUCT_TREND_DOWN and code1h == STRUCT_CONTRACTING ? "DOWN / 1H COMPRESSION" :
          code4h == STRUCT_CONTRACTING and code1h == STRUCT_CONTRACTING ? "COMPRESSION" :
          code4h == STRUCT_EXPANDING and code1h == STRUCT_CONTRACTING ? "TRANSITION" :
          code4h == STRUCT_CONTRACTING and code1h == STRUCT_EXPANDING ? "TRANSITION" :
          code4h == STRUCT_EXPANDING or code1h == STRUCT_EXPANDING ? "TRANSITION" : "MIXED"
    result

f_alignmentColor(int code4h, int code1h) =>
    code4h == STRUCT_TREND_UP and code1h == STRUCT_TREND_UP ? color.lime :
     code4h == STRUCT_TREND_DOWN and code1h == STRUCT_TREND_DOWN ? color.red :
     code4h == STRUCT_WARMING or code1h == STRUCT_WARMING ? color.orange :
     code4h == STRUCT_EXPANDING or code1h == STRUCT_EXPANDING ? color.orange :
     code4h == STRUCT_CONTRACTING and code1h == STRUCT_CONTRACTING ? color.aqua : color.silver

string structureEnvironment = f_alignmentText(structure4h, structure1h)

// -----------------------------------------------------------------------------
// Session engines
// -----------------------------------------------------------------------------
bool inNyActiveSession = not na(time(timeframe.period, nyActiveSession, WC_TZ))
bool nySessionStarted = inNyActiveSession and not inNyActiveSession[1]
bool nySessionEnded = not inNyActiveSession and inNyActiveSession[1]

bool inProfileSession = not na(time(timeframe.period, profileSession, WC_TZ))
bool profileSessionStarted = inProfileSession and not inProfileSession[1]
bool profileSessionEnded = not inProfileSession and inProfileSession[1]

// -----------------------------------------------------------------------------
// Phase 5 - participation filter
//
// Auto mode uses the transcript's absolute 20K-style logic only on MNQ.
// Other symbols default to a relative-volume model because raw volume scales
// differ materially across futures, CFDs, forex, indices, and data providers.
// The relative baseline uses only prior confirmed 5M bars from 09:30-11:00 NY.
// -----------------------------------------------------------------------------
bool isMnq = syminfo.type == "futures" and str.upper(syminfo.root) == "MNQ"
bool participationUsesAbsolute = participationModeInput == "Absolute" or (participationModeInput == "Auto" and isMnq)
string participationResolvedMode = participationUsesAbsolute ? (participationModeInput == "Auto" ? "AUTO · MNQ ABS" : "ABSOLUTE") : (participationModeInput == "Auto" ? "AUTO · RELATIVE" : "RELATIVE")

var array<float> participationHistory = array.new_float()

f_arrayAverage(array<float> values) =>
    float result = na
    int n = array.size(values)
    if n > 0
        float total = 0.0
        int valid = 0
        for i = 0 to n - 1
            float v = array.get(values, i)
            if not na(v) and v > 0
                total += v
                valid += 1
        result := valid > 0 ? total / valid : na
    result

// Baseline is evaluated before the current confirmed bar is added, preventing
// the bar being classified from diluting its own relative-volume comparison.
float participationBaseline = f_arrayAverage(participationHistory)
int participationBaselineSamples = array.size(participationHistory)
bool participationVolumeAvailable = not na(volume) and volume > 0
float participationRatio = participationVolumeAvailable and not na(participationBaseline) and participationBaseline > 0 ? volume / participationBaseline : na

if barstate.isconfirmed and inNyActiveSession and participationVolumeAvailable
    array.push(participationHistory, volume)
    while array.size(participationHistory) > relativeLookback
        array.shift(participationHistory)

string participationState = "OUTSIDE NY"
bool participationPass = false
if inNyActiveSession
    if not participationVolumeAvailable
        participationState := "NO VOLUME"
    else if participationUsesAbsolute
        participationState := volume < absoluteVolumeThreshold ? "LOW" : volume >= absoluteVolumeThreshold * highAbsoluteMultiplier ? "HIGH" : "NORMAL"
        participationPass := volume >= absoluteVolumeThreshold
    else if participationBaselineSamples < relativeMinSamples or na(participationRatio)
        participationState := "WARMING"
    else
        participationState := participationRatio < relativePassRatio ? "LOW" : participationRatio >= highParticipationRatio ? "HIGH" : "NORMAL"
        participationPass := participationRatio >= relativePassRatio

// -----------------------------------------------------------------------------
// Phase 5.1 - static historical participation validation
// This replaces the need for Bar Replay on plans where 5M replay is unavailable.
// Every confirmed NY-window bar is classified using only information available
// before/current on that bar. Session-end labels summarize the completed window.
// -----------------------------------------------------------------------------
var int partSessionHigh = 0
var int partSessionNormal = 0
var int partSessionLow = 0
var int partSessionWarming = 0
var int partSessionNoVolume = 0

if nySessionStarted
    partSessionHigh := 0
    partSessionNormal := 0
    partSessionLow := 0
    partSessionWarming := 0
    partSessionNoVolume := 0

if barstate.isconfirmed and inNyActiveSession
    if participationState == "HIGH"
        partSessionHigh += 1
    else if participationState == "NORMAL"
        partSessionNormal += 1
    else if participationState == "LOW"
        partSessionLow += 1
    else if participationState == "WARMING"
        partSessionWarming += 1
    else if participationState == "NO VOLUME"
        partSessionNoVolume += 1

bool showPartHistoryBar = showHistoricalParticipation and inTestWindow and inNyActiveSession
plotchar(showPartHistoryBar and participationState == "HIGH", title="Participation HIGH", char="H", location=location.bottom, color=color.lime, size=size.tiny, display=display.pane)
plotchar(showPartHistoryBar and participationState == "NORMAL", title="Participation NORMAL", char="N", location=location.bottom, color=color.aqua, size=size.tiny, display=display.pane)
plotchar(showPartHistoryBar and participationState == "LOW", title="Participation LOW", char="L", location=location.bottom, color=color.red, size=size.tiny, display=display.pane)
plotchar(showPartHistoryBar and participationState == "WARMING", title="Participation WARMING", char="W", location=location.bottom, color=color.orange, size=size.tiny, display=display.pane)
plotchar(showPartHistoryBar and participationState == "NO VOLUME", title="Participation NO VOLUME", char="X", location=location.bottom, color=color.fuchsia, size=size.tiny, display=display.pane)

if nySessionEnded and showParticipationSessionSummary and inTestWindow
    string partSummary = "P  H" + str.tostring(partSessionHigh) + "  N" + str.tostring(partSessionNormal) + "  L" + str.tostring(partSessionLow) + "  W" + str.tostring(partSessionWarming) + "  X" + str.tostring(partSessionNoVolume)
    label.new(bar_index - 1, low[1], partSummary, xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.black, 72), textcolor=color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// Lower-timeframe profile feed
// Each 5M bar supplies its available lower-timeframe sub-bars.
// -----------------------------------------------------------------------------
[ltfOpens, ltfHighs, ltfLows, ltfCloses, ltfVolumes] = request.security_lower_tf(
    syminfo.tickerid,
    profileLtf,
    [open, high, low, close, volume])

// -----------------------------------------------------------------------------
// Phase 6A - free-plan lower-timeframe order-flow proxy
//
// Native footprint data is not requested in this build. Instead, each available
// lower-timeframe sub-bar contributes its feed volume to a directional bucket:
//   close > open  -> buy proxy
//   close < open  -> sell proxy
//   doji           -> use close-to-close direction when available, else neutral
// This is intentionally labelled PROXY throughout the UI.
// -----------------------------------------------------------------------------
int orderflowLtfSamples = array.size(ltfCloses)
int orderflowPositiveVolumeSamples = 0
float orderflowBuyVolume = 0.0
float orderflowSellVolume = 0.0
float orderflowNeutralVolume = 0.0

if orderflowLtfSamples > 0
    for i = 0 to orderflowLtfSamples - 1
        float o = array.get(ltfOpens, i)
        float c = array.get(ltfCloses, i)
        float v = array.get(ltfVolumes, i)
        if not na(v) and v > 0 and not na(o) and not na(c)
            orderflowPositiveVolumeSamples += 1
            if c > o
                orderflowBuyVolume += v
            else if c < o
                orderflowSellVolume += v
            else
                float prevClose = i > 0 ? array.get(ltfCloses, i - 1) : na
                if not na(prevClose) and c > prevClose
                    orderflowBuyVolume += v
                else if not na(prevClose) and c < prevClose
                    orderflowSellVolume += v
                else
                    orderflowNeutralVolume += v

float orderflowClassifiedVolume = orderflowBuyVolume + orderflowSellVolume
float orderflowTotalProxyVolume = orderflowClassifiedVolume + orderflowNeutralVolume
float orderflowDelta = orderflowBuyVolume - orderflowSellVolume
float orderflowDeltaPct = orderflowTotalProxyVolume > 0 ? orderflowDelta / orderflowTotalProxyVolume * 100.0 : na
float orderflowBuyPct = orderflowTotalProxyVolume > 0 ? orderflowBuyVolume / orderflowTotalProxyVolume * 100.0 : na
float orderflowSellPct = orderflowTotalProxyVolume > 0 ? orderflowSellVolume / orderflowTotalProxyVolume * 100.0 : na

bool orderflowDataReady = orderflowLtfSamples >= orderflowMinSamples and orderflowPositiveVolumeSamples >= orderflowMinSamples and orderflowTotalProxyVolume > 0
string orderflowDataState = orderflowLtfSamples == 0 ? "NO LTF DATA" : orderflowPositiveVolumeSamples == 0 ? "NO VOLUME" : not orderflowDataReady ? "PARTIAL" : "READY"
string orderflowDeltaState = not orderflowDataReady or na(orderflowDeltaPct) ? "NO DATA" : math.abs(orderflowDeltaPct) <= orderflowNeutralDeltaPct ? "NEUTRAL" : orderflowDeltaPct > 0 ? "POSITIVE" : "NEGATIVE"
string orderflowProxySource = (syminfo.type == "forex" or syminfo.type == "cfd") ? "LTF TICK PROXY" : "LTF VOL PROXY"

// Static validation markers and summary, so no Bar Replay is required.
var int ofSessionPositive = 0
var int ofSessionNegative = 0
var int ofSessionNeutral = 0
var int ofSessionMissing = 0
var float ofSessionDeltaPctSum = 0.0
var int ofSessionDeltaPctCount = 0

if nySessionStarted
    ofSessionPositive := 0
    ofSessionNegative := 0
    ofSessionNeutral := 0
    ofSessionMissing := 0
    ofSessionDeltaPctSum := 0.0
    ofSessionDeltaPctCount := 0

if barstate.isconfirmed and inNyActiveSession
    if not orderflowDataReady
        ofSessionMissing += 1
    else if orderflowDeltaState == "POSITIVE"
        ofSessionPositive += 1
    else if orderflowDeltaState == "NEGATIVE"
        ofSessionNegative += 1
    else
        ofSessionNeutral += 1

    if orderflowDataReady and not na(orderflowDeltaPct)
        ofSessionDeltaPctSum += orderflowDeltaPct
        ofSessionDeltaPctCount += 1

bool showOfHistoryBar = debugMode and showHistoricalOrderflow and inTestWindow and inNyActiveSession
plotchar(showOfHistoryBar and orderflowDeltaState == "POSITIVE", title="OF Proxy Positive Delta", char="+", location=location.top, color=color.lime, size=size.tiny, display=display.pane)
plotchar(showOfHistoryBar and orderflowDeltaState == "NEGATIVE", title="OF Proxy Negative Delta", char="-", location=location.top, color=color.red, size=size.tiny, display=display.pane)
plotchar(showOfHistoryBar and orderflowDeltaState == "NEUTRAL", title="OF Proxy Neutral Delta", char="0", location=location.top, color=color.silver, size=size.tiny, display=display.pane)
plotchar(showOfHistoryBar and not orderflowDataReady, title="OF Proxy Missing Data", char="X", location=location.top, color=color.fuchsia, size=size.tiny, display=display.pane)

if nySessionEnded and showOrderflowSessionSummary and inTestWindow
    float avgSessionDeltaPct = ofSessionDeltaPctCount > 0 ? ofSessionDeltaPctSum / ofSessionDeltaPctCount : na
    string avgDeltaText = na(avgSessionDeltaPct) ? "n/a" : str.tostring(avgSessionDeltaPct, "#.0") + "%"
    string ofSummary = "OF PROXY  +" + str.tostring(ofSessionPositive) + "  -" + str.tostring(ofSessionNegative) + "  0" + str.tostring(ofSessionNeutral) + "  X" + str.tostring(ofSessionMissing) + "  avgΔ " + avgDeltaText
    label.new(bar_index - 1, high[1], ofSummary, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.black, 72), textcolor=color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// Phase 6B - aggression engine
//
// Aggression is NOT simply positive/negative delta. A bar must:
// 1) have usable LTF proxy data,
// 2) exceed a configurable minimum absolute delta %,
// 3) exceed an adaptive threshold derived from prior confirmed NY bars once the
//    baseline has warmed, and
// 4) pass the participation filter when that requirement is enabled.
//
// The current bar is classified before its |delta| is added to the history, so
// it cannot dilute the threshold used to classify itself.
// -----------------------------------------------------------------------------
var array<float> aggressionDeltaHistory = array.new_float()

float aggressionBaselineAbsDelta = f_arrayAverage(aggressionDeltaHistory)
int aggressionBaselineSamples = array.size(aggressionDeltaHistory)
bool aggressionBaselineReady = aggressionBaselineSamples >= aggressionMinSamples and not na(aggressionBaselineAbsDelta)
float aggressionAdaptiveThreshold = aggressionBaselineReady ? aggressionBaselineAbsDelta * aggressionAdaptiveMultiplier : aggressionDeltaFloorPct
float aggressionThresholdPct = math.max(aggressionDeltaFloorPct, aggressionAdaptiveThreshold)
float aggressionStrongThresholdPct = aggressionThresholdPct * strongAggressionMultiplier
bool aggressionParticipationOk = not aggressionRequireParticipation or participationPass

bool buyerAggression = inNyActiveSession and orderflowDataReady and aggressionParticipationOk and not na(orderflowDeltaPct) and orderflowDeltaPct >= aggressionThresholdPct
bool sellerAggression = inNyActiveSession and orderflowDataReady and aggressionParticipationOk and not na(orderflowDeltaPct) and orderflowDeltaPct <= -aggressionThresholdPct
bool aggressionDetected = buyerAggression or sellerAggression
bool aggressionStrong = aggressionDetected and (math.abs(orderflowDeltaPct) >= aggressionStrongThresholdPct or participationState == "HIGH")

string aggressionState = not inNyActiveSession ? "OUTSIDE NY" :
  not orderflowDataReady ? "NO DATA" :
  aggressionRequireParticipation and not participationPass ? "BLOCKED · VOLUME" :
  buyerAggression ? "BUYERS · " + (aggressionStrong ? "STRONG" : "ACTIVE") :
  sellerAggression ? "SELLERS · " + (aggressionStrong ? "STRONG" : "ACTIVE") : "NONE"

if barstate.isconfirmed and inNyActiveSession and orderflowDataReady and not na(orderflowDeltaPct)
    array.push(aggressionDeltaHistory, math.abs(orderflowDeltaPct))
    while array.size(aggressionDeltaHistory) > aggressionLookback
        array.shift(aggressionDeltaHistory)

// Static historical validation. Only aggressive bars are marked in normal mode.
// Raw +/- delta markers remain available through Debug mode.
var int aggSessionBuy = 0
var int aggSessionSell = 0
var int aggSessionNone = 0
var int aggSessionMissing = 0
var float aggSessionThresholdSum = 0.0
var int aggSessionThresholdCount = 0

if nySessionStarted
    aggSessionBuy := 0
    aggSessionSell := 0
    aggSessionNone := 0
    aggSessionMissing := 0
    aggSessionThresholdSum := 0.0
    aggSessionThresholdCount := 0

if barstate.isconfirmed and inNyActiveSession
    if not orderflowDataReady
        aggSessionMissing += 1
    else if buyerAggression
        aggSessionBuy += 1
    else if sellerAggression
        aggSessionSell += 1
    else
        aggSessionNone += 1

    if orderflowDataReady and not na(aggressionThresholdPct)
        aggSessionThresholdSum += aggressionThresholdPct
        aggSessionThresholdCount += 1

bool showAggHistoryBar = showHistoricalAggression and inTestWindow and inNyActiveSession
plotshape(showAggHistoryBar and buyerAggression, title="Buyer Aggression", style=shape.triangleup, location=location.belowbar, color=aggressionStrong ? color.lime : color.aqua, size=size.tiny, display=display.pane)
plotshape(showAggHistoryBar and sellerAggression, title="Seller Aggression", style=shape.triangledown, location=location.abovebar, color=aggressionStrong ? color.red : color.orange, size=size.tiny, display=display.pane)

if nySessionEnded and showAggressionSessionSummary and inTestWindow
    float avgAggThreshold = aggSessionThresholdCount > 0 ? aggSessionThresholdSum / aggSessionThresholdCount : na
    string avgAggThresholdText = na(avgAggThreshold) ? "n/a" : str.tostring(avgAggThreshold, "#.0") + "%"
    string aggSummary = "AGG PROXY  B" + str.tostring(aggSessionBuy) + "  S" + str.tostring(aggSessionSell) + "  N" + str.tostring(aggSessionNone) + "  X" + str.tostring(aggSessionMissing) + "  thr " + avgAggThresholdText
    label.new(bar_index - 1, high[1], aggSummary, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.black, 68), textcolor=color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// Phase 6C - absorption / effort versus result
//
// Aggression is the effort. This layer asks whether that effort achieved a
// proportional directional result on the same 5M bar. Because this Free-plan
// build uses a directional-volume proxy rather than true bid/ask footprint
// delta, all absorption labels remain explicitly diagnostic / suspected.
//
// Three mirrored tests are scored only after aggression is detected:
// 1) Poor directional body progress in the aggressor's direction.
// 2) The close recovers away from the aggressor-side extreme.
// 3) A rejection wick forms against the aggressor.
// Score 3/3 = absorption suspected. Score 2/3 = potential absorption.
// -----------------------------------------------------------------------------
float absorptionBarRange = math.max(high - low, syminfo.mintick)
float lowerWick = math.max(0.0, math.min(open, close) - low)
float upperWick = math.max(0.0, high - math.max(open, close))
float lowerWickPct = lowerWick / absorptionBarRange * 100.0
float upperWickPct = upperWick / absorptionBarRange * 100.0

// Progress in the aggressor's direction. Negative body progress is floored at 0
// because a close against the aggressor is, by definition, poor directional result.
float buyerDirectionalProgressPct = math.max(0.0, (close - open) / absorptionBarRange * 100.0)
float sellerDirectionalProgressPct = math.max(0.0, (open - close) / absorptionBarRange * 100.0)

// Counter-recovery from the aggressor-side extreme.
// Sellers: recovery up from the low. Buyers: recovery down from the high.
float sellerCounterRecoveryPct = (close - low) / absorptionBarRange * 100.0
float buyerCounterRecoveryPct = (high - close) / absorptionBarRange * 100.0

float activeDirectionalProgressPct = buyerAggression ? buyerDirectionalProgressPct : sellerAggression ? sellerDirectionalProgressPct : na
float activeCounterRecoveryPct = buyerAggression ? buyerCounterRecoveryPct : sellerAggression ? sellerCounterRecoveryPct : na
float activeRejectionWickPct = buyerAggression ? upperWickPct : sellerAggression ? lowerWickPct : na

bool absorptionPoorProgress = aggressionDetected and not na(activeDirectionalProgressPct) and activeDirectionalProgressPct <= absorptionMaxProgressPct
bool absorptionRecoveredClose = aggressionDetected and not na(activeCounterRecoveryPct) and activeCounterRecoveryPct >= absorptionMinRecoveryPct
bool absorptionRejectionWick = aggressionDetected and not na(activeRejectionWickPct) and activeRejectionWickPct >= absorptionMinWickPct
int absorptionScore = aggressionDetected ? (absorptionPoorProgress ? 1 : 0) + (absorptionRecoveredClose ? 1 : 0) + (absorptionRejectionWick ? 1 : 0) : 0

bool sellerAbsorption = sellerAggression and absorptionScore == 3
bool buyerAbsorption = buyerAggression and absorptionScore == 3
bool absorptionDetected = sellerAbsorption or buyerAbsorption
bool sellerPotentialAbsorption = sellerAggression and absorptionScore == 2
bool buyerPotentialAbsorption = buyerAggression and absorptionScore == 2
bool potentialAbsorption = sellerPotentialAbsorption or buyerPotentialAbsorption

string absorptionState = not inNyActiveSession ? "OUTSIDE NY" :
  not orderflowDataReady ? "NO DATA" :
  not aggressionDetected ? "WAIT · AGGRESSION" :
  sellerAbsorption ? "SELLER ABSORPTION · 3/3" :
  buyerAbsorption ? "BUYER ABSORPTION · 3/3" :
  sellerPotentialAbsorption ? "POTENTIAL · SELLERS · 2/3" :
  buyerPotentialAbsorption ? "POTENTIAL · BUYERS · 2/3" : "NO ABSORPTION"

// Static validation: counts always sum to the full NY window when data exists.
var int absSessionSeller = 0
var int absSessionBuyer = 0
var int absSessionPotential = 0
var int absSessionNone = 0
var int absSessionMissing = 0

if nySessionStarted
    absSessionSeller := 0
    absSessionBuyer := 0
    absSessionPotential := 0
    absSessionNone := 0
    absSessionMissing := 0

if barstate.isconfirmed and inNyActiveSession
    if not orderflowDataReady
        absSessionMissing += 1
    else if sellerAbsorption
        absSessionSeller += 1
    else if buyerAbsorption
        absSessionBuyer += 1
    else if potentialAbsorption
        absSessionPotential += 1
    else
        absSessionNone += 1

bool showAbsHistoryBar = showHistoricalAbsorption and inTestWindow and inNyActiveSession
// Seller absorption means aggressive selling met rejection; marker sits below the bar.
plotshape(showAbsHistoryBar and sellerAbsorption, title="Seller Absorption Suspected", style=shape.diamond, location=location.belowbar, color=color.lime, size=size.tiny, display=display.pane)
// Buyer absorption means aggressive buying met rejection; marker sits above the bar.
plotshape(showAbsHistoryBar and buyerAbsorption, title="Buyer Absorption Suspected", style=shape.diamond, location=location.abovebar, color=color.red, size=size.tiny, display=display.pane)
plotshape(showAbsHistoryBar and showPotentialAbsorption and sellerPotentialAbsorption, title="Potential Seller Absorption", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 35), size=size.tiny, display=display.pane)
plotshape(showAbsHistoryBar and showPotentialAbsorption and buyerPotentialAbsorption, title="Potential Buyer Absorption", style=shape.circle, location=location.abovebar, color=color.new(color.red, 35), size=size.tiny, display=display.pane)

if nySessionEnded and showAbsorptionSessionSummary and inTestWindow
    string absSummary = "ABS PROXY  SA" + str.tostring(absSessionSeller) + "  BA" + str.tostring(absSessionBuyer) + "  P" + str.tostring(absSessionPotential) + "  N" + str.tostring(absSessionNone) + "  X" + str.tostring(absSessionMissing)
    label.new(bar_index - 1, low[1], absSummary, xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.black, 68), textcolor=color.white, size=size.tiny)

var array<float> sessionHighs = array.new_float()
var array<float> sessionLows = array.new_float()
var array<float> sessionVolumes = array.new_float()
var int activeProfileStartTime = na

// Latest two completed profiles.
var float latestVah = na
var float latestPoc = na
var float latestVal = na
var float latestProfileHigh = na
var float latestProfileLow = na
var float latestProfileVolume = na
var int latestProfileStartTime = na
var int latestProfileEndTime = na

var float priorVah = na
var float priorPoc = na
var float priorVal = na
var int priorProfileStartTime = na

// Profile-data diagnostics. These describe the most recent attempted profile
// even when that session could not produce a valid volume profile.
var int lastAttemptSamples = 0
var int lastAttemptPositiveVolumeSamples = 0

// -----------------------------------------------------------------------------
// Volume-profile calculation
// Volume from each lower-timeframe bar is distributed across the profile rows
// in proportion to the overlap between the bar's high-low range and each row.
// -----------------------------------------------------------------------------
f_computeProfile(array<float> highs, array<float> lows, array<float> vols, int rows, float vaPct) =>
    float resultPoc = na
    float resultVah = na
    float resultVal = na
    float resultHigh = na
    float resultLow = na
    float resultVolume = na

    int n = array.size(highs)
    if n > 0 and array.size(lows) == n and array.size(vols) == n
        float sessionHigh = -1e20
        float sessionLow = 1e20
        float totalInputVolume = 0.0

        for i = 0 to n - 1
            float h = array.get(highs, i)
            float l = array.get(lows, i)
            float v = array.get(vols, i)
            if not na(h) and not na(l)
                sessionHigh := math.max(sessionHigh, h)
                sessionLow := math.min(sessionLow, l)
            if not na(v)
                totalInputVolume += math.max(v, 0.0)

        float span = sessionHigh - sessionLow
        if sessionHigh > sessionLow and totalInputVolume > 0 and span > 0
            float rowHeight = span / rows
            array<float> bins = array.new_float(rows, 0.0)

            for i = 0 to n - 1
                float h = array.get(highs, i)
                float l = array.get(lows, i)
                float rawVol = array.get(vols, i)
                float v = na(rawVol) ? 0.0 : math.max(rawVol, 0.0)
                if not na(h) and not na(l) and v > 0
                    float barRange = h - l
                    if barRange <= syminfo.mintick * 0.1
                        int idx = int(math.floor((h - sessionLow) / rowHeight))
                        idx := math.max(0, math.min(rows - 1, idx))
                        array.set(bins, idx, array.get(bins, idx) + v)
                    else
                        float allocated = 0.0
                        for r = 0 to rows - 1
                            float rowLow = sessionLow + r * rowHeight
                            float rowHigh = rowLow + rowHeight
                            float overlap = math.max(0.0, math.min(h, rowHigh) - math.max(l, rowLow))
                            if overlap > 0
                                float rowVol = v * overlap / barRange
                                array.set(bins, r, array.get(bins, r) + rowVol)
                                allocated += rowVol

                        // Protect against floating-point edge loss on the range boundaries.
                        if allocated < v * 0.999
                            float mid = (h + l) * 0.5
                            int midIdx = int(math.floor((mid - sessionLow) / rowHeight))
                            midIdx := math.max(0, math.min(rows - 1, midIdx))
                            array.set(bins, midIdx, array.get(bins, midIdx) + (v - allocated))

            int pocIndex = 0
            float pocVolume = -1.0
            float binnedVolume = 0.0
            for r = 0 to rows - 1
                float rv = array.get(bins, r)
                binnedVolume += rv
                if rv > pocVolume
                    pocVolume := rv
                    pocIndex := r

            float targetVolume = binnedVolume * vaPct / 100.0
            float cumulative = array.get(bins, pocIndex)
            int lowerIndex = pocIndex
            int upperIndex = pocIndex
            int nextLower = pocIndex - 1
            int nextUpper = pocIndex + 1

            while cumulative < targetVolume and (nextLower >= 0 or nextUpper < rows)
                float lowerVol = nextLower >= 0 ? array.get(bins, nextLower) : -1.0
                float upperVol = nextUpper < rows ? array.get(bins, nextUpper) : -1.0

                if upperVol >= lowerVol
                    if nextUpper < rows
                        cumulative += math.max(upperVol, 0.0)
                        upperIndex := nextUpper
                        nextUpper += 1
                    else if nextLower >= 0
                        cumulative += math.max(lowerVol, 0.0)
                        lowerIndex := nextLower
                        nextLower -= 1
                else
                    if nextLower >= 0
                        cumulative += math.max(lowerVol, 0.0)
                        lowerIndex := nextLower
                        nextLower -= 1
                    else if nextUpper < rows
                        cumulative += math.max(upperVol, 0.0)
                        upperIndex := nextUpper
                        nextUpper += 1

            resultPoc := sessionLow + (pocIndex + 0.5) * rowHeight
            resultVah := sessionLow + (upperIndex + 1.0) * rowHeight
            resultVal := sessionLow + lowerIndex * rowHeight
            resultHigh := sessionHigh
            resultLow := sessionLow
            resultVolume := binnedVolume

    [resultPoc, resultVah, resultVal, resultHigh, resultLow, resultVolume]

f_countPositiveVolume(array<float> vols) =>
    int positive = 0
    int n = array.size(vols)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(vols, i)
            if not na(v) and v > 0
                positive += 1
    positive

// Reset the collector at the start of each profile session.
if profileSessionStarted
    array.clear(sessionHighs)
    array.clear(sessionLows)
    array.clear(sessionVolumes)
    activeProfileStartTime := time

// Append all available lower-timeframe bars while inside the configured profile session.
if inProfileSession
    int intrabarCount = array.size(ltfHighs)
    if intrabarCount > 0
        for i = 0 to intrabarCount - 1
            array.push(sessionHighs, array.get(ltfHighs, i))
            array.push(sessionLows, array.get(ltfLows, i))
            array.push(sessionVolumes, array.get(ltfVolumes, i))

// Finalize the just-completed profile on the first bar outside its session.
if profileSessionEnded and array.size(sessionHighs) > 0
    lastAttemptSamples := array.size(sessionVolumes)
    lastAttemptPositiveVolumeSamples := f_countPositiveVolume(sessionVolumes)

    [closedPoc, closedVah, closedVal, closedHigh, closedLow, closedVolume] = f_computeProfile(
        sessionHighs, sessionLows, sessionVolumes, profileRows, valueAreaPct)

    bool closedProfileValid = not na(closedVah) and not na(closedPoc) and not na(closedVal)

    // Only promote a completed profile when it is valid. This prevents a
    // zero-volume session from overwriting the most recent usable value map.
    if closedProfileValid
        priorVah := latestVah
        priorPoc := latestPoc
        priorVal := latestVal
        priorProfileStartTime := latestProfileStartTime

        latestVah := closedVah
        latestPoc := closedPoc
        latestVal := closedVal
        latestProfileHigh := closedHigh
        latestProfileLow := closedLow
        latestProfileVolume := closedVolume
        latestProfileStartTime := activeProfileStartTime
        latestProfileEndTime := time[1]

        // Optional closed-session segments for seven-day visual validation.
        if debugMode and debugHistoricalProfiles and inTestWindow[1] and not na(activeProfileStartTime)
            line.new(activeProfileStartTime, closedVah, time[1], closedVah, xloc=xloc.bar_time, color=color.new(color.aqua, 60), width=1)
            line.new(activeProfileStartTime, closedPoc, time[1], closedPoc, xloc=xloc.bar_time, color=color.new(color.yellow, 65), width=1, style=line.style_dotted)
            line.new(activeProfileStartTime, closedVal, time[1], closedVal, xloc=xloc.bar_time, color=color.new(color.aqua, 60), width=1)

// Developing profile is calculated only on the current last bar to keep the
// historical pass light. Outside the profile session, latest completed levels
// become the active map.
int currentCollectorSamples = inProfileSession ? array.size(sessionVolumes) : 0
int currentPositiveVolumeSamples = inProfileSession ? f_countPositiveVolume(sessionVolumes) : 0

float developingPoc = na
float developingVah = na
float developingVal = na
if barstate.islast and inProfileSession and currentPositiveVolumeSamples > 0
    [devPoc, devVah, devVal, devHigh, devLow, devVolume] = f_computeProfile(
        sessionHighs, sessionLows, sessionVolumes, profileRows, valueAreaPct)
    developingPoc := devPoc
    developingVah := devVah
    developingVal := devVal

float activeVah = inProfileSession and not na(developingVah) ? developingVah : latestVah
float activePoc = inProfileSession and not na(developingPoc) ? developingPoc : latestPoc
float activeVal = inProfileSession and not na(developingVal) ? developingVal : latestVal
int activeMapStart = inProfileSession and not na(activeProfileStartTime) ? activeProfileStartTime : latestProfileStartTime

f_valueMigration(float vahNow, float pocNow, float valNow, float vahPrev, float pocPrev, float valPrev) =>
    string result = "NO DATA"
    bool hasCurrent = not na(vahNow) and not na(pocNow) and not na(valNow)
    bool hasReference = not na(vahPrev) and not na(pocPrev) and not na(valPrev)
    if hasCurrent and not hasReference
        result := "WARMING"
    else if hasCurrent and hasReference
        float tolerance = syminfo.mintick
        bool vahHigher = vahNow > vahPrev + tolerance
        bool vahLower = vahNow < vahPrev - tolerance
        bool valHigher = valNow > valPrev + tolerance
        bool valLower = valNow < valPrev - tolerance
        float midNow = (vahNow + valNow) * 0.5
        float midPrev = (vahPrev + valPrev) * 0.5

        result := vahHigher and valHigher ? "VALUE UP" :
          vahLower and valLower ? "VALUE DOWN" :
          vahHigher and valLower ? "VALUE EXPANDING" :
          vahLower and valHigher ? "VALUE CONTRACTING" :
          midNow > midPrev + tolerance and pocNow > pocPrev + tolerance ? "OVERLAP UP" :
          midNow < midPrev - tolerance and pocNow < pocPrev - tolerance ? "OVERLAP DOWN" : "OVERLAP"
    result

f_valueOverlapPct(float vahNow, float valNow, float vahPrev, float valPrev) =>
    float result = na
    bool valid = not na(vahNow) and not na(valNow) and not na(vahPrev) and not na(valPrev)
    if valid
        float currentWidth = math.max(vahNow - valNow, syminfo.mintick)
        float priorWidth = math.max(vahPrev - valPrev, syminfo.mintick)
        float overlapWidth = math.max(0.0, math.min(vahNow, vahPrev) - math.max(valNow, valPrev))
        float denominator = math.max(math.min(currentWidth, priorWidth), syminfo.mintick)
        result := math.min(100.0, math.max(0.0, overlapWidth / denominator * 100.0))
    result

f_migrationQuality(string migration, float overlapPct) =>
    string result = "NO DATA"
    bool directional = migration == "VALUE UP" or migration == "VALUE DOWN" or migration == "OVERLAP UP" or migration == "OVERLAP DOWN"
    if migration == "WARMING"
        result := "WARMING"
    else if directional and not na(overlapPct)
        result := overlapPct <= 20.0 ? "STRONG" : overlapPct <= 50.0 ? "MODERATE" : "WEAK"
    else if migration == "VALUE EXPANDING"
        result := "EXPANSION"
    else if migration == "VALUE CONTRACTING"
        result := "COMPRESSION"
    else if migration == "OVERLAP" and not na(overlapPct)
        result := overlapPct >= 70.0 ? "BALANCED" : "ROTATION"
    result

float referenceVah = inProfileSession and not na(developingVah) ? latestVah : priorVah
float referencePoc = inProfileSession and not na(developingPoc) ? latestPoc : priorPoc
float referenceVal = inProfileSession and not na(developingVal) ? latestVal : priorVal

string valueMigration = f_valueMigration(activeVah, activePoc, activeVal, referenceVah, referencePoc, referenceVal)
float valueOverlapPct = f_valueOverlapPct(activeVah, activeVal, referenceVah, referenceVal)
string migrationQuality = f_migrationQuality(valueMigration, valueOverlapPct)

f_valueColor(string state) =>
    state == "VALUE UP" or state == "OVERLAP UP" ? color.lime :
     state == "VALUE DOWN" or state == "OVERLAP DOWN" ? color.red :
     state == "VALUE EXPANDING" ? color.orange :
     state == "VALUE CONTRACTING" ? color.aqua :
     state == "NO DATA" ? color.red : color.silver

f_combinedEnvironment(string structureState, string valueState) =>
    string result = "WAIT"
    bool valueUp = valueState == "VALUE UP" or valueState == "OVERLAP UP"
    bool valueDown = valueState == "VALUE DOWN" or valueState == "OVERLAP DOWN"
    bool transitionValue = valueState == "VALUE EXPANDING" or valueState == "VALUE CONTRACTING" or valueState == "OVERLAP"

    result := valueState == "NO DATA" ? "NO VALUE DATA / WAIT" :
      structureState == "ALIGNED UP" and valueUp ? "BULLISH ACCEPTANCE" :
      structureState == "ALIGNED DOWN" and valueDown ? "BEARISH ACCEPTANCE" :
      structureState == "4H UP / 1H PULLBACK" and valueUp ? "BULLISH PULLBACK" :
      structureState == "4H DOWN / 1H PULLBACK" and valueDown ? "BEARISH PULLBACK" :
      transitionValue or structureState == "TRANSITION" or structureState == "COMPRESSION" ? "TRANSITION / WAIT" : "MIXED / WAIT"
    result

string environmentState = f_combinedEnvironment(structureEnvironment, valueMigration)

// -----------------------------------------------------------------------------
// Phase 3 / Phase 9.1 - manual GEX / volatility context with input safety
// GEX remains contextual, never a directional entry signal. Production safety:
// - OFF is the default.
// - All three levels must be non-zero when GEX is enabled.
// - Call Wall must be above Put Wall.
// - A manually selected Positive regime cannot sit below the entered Gamma Flip,
//   and a Negative regime cannot sit above it. Neutral is allowed on either side.
// Invalid/incomplete GEX is suppressed from drawings and plan targets.
// -----------------------------------------------------------------------------
bool gexLevelsComplete = gammaFlipInput > 0 and callWallInput > 0 and putWallInput > 0
bool gexWallOrderValid = gexLevelsComplete and callWallInput > putWallInput
bool gexPositiveFlipConflict = gexLevelsComplete and gexRegimeInput == "Positive" and close < gammaFlipInput
bool gexNegativeFlipConflict = gexLevelsComplete and gexRegimeInput == "Negative" and close > gammaFlipInput
bool gexRegimeFlipConflict = gexPositiveFlipConflict or gexNegativeFlipConflict
bool gexConfigured = useGex and gexLevelsComplete and gexWallOrderValid and not gexRegimeFlipConflict

string gexInputStatus = not useGex ? "NOT CONFIGURED" :
  not gexLevelsComplete ? "INPUT INCOMPLETE" :
  not gexWallOrderValid ? "WALL ORDER INVALID" :
  gexRegimeFlipConflict ? "REGIME / FLIP CONFLICT" : "READY"

string gexRegime = gexConfigured ? str.upper(gexRegimeInput) : "OFF"
string gexVolatility = gexConfigured ? (gexRegimeInput == "Positive" ? "DAMPENED" : gexRegimeInput == "Negative" ? "AMPLIFIED" : "NEUTRAL") : "OFF"
float gammaFlip = gexConfigured ? gammaFlipInput : na
float callWall = gexConfigured ? callWallInput : na
float putWall = gexConfigured ? putWallInput : na

f_flipRelation(float flipLevel) =>
    na(flipLevel) ? "n/a" : close > flipLevel ? "ABOVE FLIP" : close < flipLevel ? "BELOW FLIP" : "AT FLIP"

string gammaFlipRelation = f_flipRelation(gammaFlip)

// -----------------------------------------------------------------------------
// Phase 4 - location engine
// The transcript defines the long example from swing low -> swing high using
// 0.705 / 0.788 / 0.886 retracements, with the zone outside value. The short
// side is a mirrored implementation for systematic testing.
// -----------------------------------------------------------------------------
f_autoLocationDirection(string envState) =>
    str.contains(envState, "BULLISH") ? LOC_LONG : str.contains(envState, "BEARISH") ? LOC_SHORT : LOC_NONE

int autoLocationDirection = f_autoLocationDirection(environmentState)
int locationDirection = locationDirectionMode == "Force Long (Test)" ? LOC_LONG : locationDirectionMode == "Force Short (Test)" ? LOC_SHORT : autoLocationDirection
bool locationTestOverride = locationDirectionMode != "Auto"

f_timeInside(int pivotTime, int startTime, int endTime) =>
    not na(pivotTime) and not na(startTime) and not na(endTime) and pivotTime > startTime and pivotTime < endTime

// Maintain a small rolling history of confirmed 15M pivots. This is more
// reliable than checking only the latest one or two pivots because the active
// 1H impulse can remain valid while several newer 15M pivots form afterward.
var array<int> pivot15Times = array.new_int()
var array<float> pivot15Prices = array.new_float()
var array<int> pivot15Types = array.new_int()  // +1 = high, -1 = low

bool new15HighPivot = not na(lastHighTime15m) and (na(lastHighTime15m[1]) or lastHighTime15m != lastHighTime15m[1])
bool new15LowPivot = not na(lastLowTime15m) and (na(lastLowTime15m[1]) or lastLowTime15m != lastLowTime15m[1])

if new15HighPivot
    array.push(pivot15Times, lastHighTime15m)
    array.push(pivot15Prices, lastHigh15m)
    array.push(pivot15Types, 1)

if new15LowPivot
    array.push(pivot15Times, lastLowTime15m)
    array.push(pivot15Prices, lastLow15m)
    array.push(pivot15Types, -1)

while array.size(pivot15Times) > 120
    array.shift(pivot15Times)
    array.shift(pivot15Prices)
    array.shift(pivot15Types)

// Select the completed 1H impulse that ends at the latest directional swing.
float baseAnchorStartPrice = na
float baseAnchorEndPrice = na
int baseAnchorStartTime = na
int baseAnchorEndTime = na

if locationDirection == LOC_LONG and not na(lastHigh1h) and not na(lastHighTime1h)
    bool lastLowBeforeHigh = not na(lastLowTime1h) and lastLowTime1h < lastHighTime1h
    baseAnchorStartPrice := lastLowBeforeHigh ? lastLow1h : prevLow1h
    baseAnchorStartTime := lastLowBeforeHigh ? lastLowTime1h : prevLowTime1h
    baseAnchorEndPrice := lastHigh1h
    baseAnchorEndTime := lastHighTime1h
else if locationDirection == LOC_SHORT and not na(lastLow1h) and not na(lastLowTime1h)
    bool lastHighBeforeLow = not na(lastHighTime1h) and lastHighTime1h < lastLowTime1h
    baseAnchorStartPrice := lastHighBeforeLow ? lastHigh1h : prevHigh1h
    baseAnchorStartTime := lastHighBeforeLow ? lastHighTime1h : prevHighTime1h
    baseAnchorEndPrice := lastLow1h
    baseAnchorEndTime := lastLowTime1h

bool baseLegValid = locationDirection == LOC_LONG ?
     not na(baseAnchorStartPrice) and not na(baseAnchorEndPrice) and not na(baseAnchorStartTime) and not na(baseAnchorEndTime) and baseAnchorStartTime < baseAnchorEndTime and baseAnchorEndPrice > baseAnchorStartPrice :
     locationDirection == LOC_SHORT ? not na(baseAnchorStartPrice) and not na(baseAnchorEndPrice) and not na(baseAnchorStartTime) and not na(baseAnchorEndTime) and baseAnchorStartTime < baseAnchorEndTime and baseAnchorStartPrice > baseAnchorEndPrice : false

// Internal 15M structure check and conservative origin refinement.
int internalLowTime = na
float internalLowPrice = na
int internalHighTime = na
float internalHighPrice = na
bool hasInternalSwing15m = false

if baseLegValid and array.size(pivot15Times) > 0
    for i = 0 to array.size(pivot15Times) - 1
        int pivotTime = array.get(pivot15Times, i)
        float pivotPrice = array.get(pivot15Prices, i)
        int pivotType = array.get(pivot15Types, i)
        if f_timeInside(pivotTime, baseAnchorStartTime, baseAnchorEndTime)
            hasInternalSwing15m := true
            if pivotType == -1 and (na(internalLowTime) or pivotTime > internalLowTime)
                internalLowTime := pivotTime
                internalLowPrice := pivotPrice
            if pivotType == 1 and (na(internalHighTime) or pivotTime > internalHighTime)
                internalHighTime := pivotTime
                internalHighPrice := pivotPrice

float anchorStartPrice = baseAnchorStartPrice
int anchorStartTime = baseAnchorStartTime
float anchorEndPrice = baseAnchorEndPrice
int anchorEndTime = baseAnchorEndTime
string anchorSource = "1H"

if baseLegValid and refineAnchorWith15m
    if locationDirection == LOC_LONG and not na(internalLowTime) and internalLowPrice >= baseAnchorStartPrice and internalLowPrice < baseAnchorEndPrice
        anchorStartPrice := internalLowPrice
        anchorStartTime := internalLowTime
        anchorSource := "1H→15M"
    else if locationDirection == LOC_SHORT and not na(internalHighTime) and internalHighPrice <= baseAnchorStartPrice and internalHighPrice > baseAnchorEndPrice
        anchorStartPrice := internalHighPrice
        anchorStartTime := internalHighTime
        anchorSource := "1H→15M"

bool anchorLegValid = locationDirection == LOC_LONG ?
     baseLegValid and not na(anchorStartPrice) and not na(anchorEndPrice) and anchorStartTime < anchorEndTime and anchorEndPrice > anchorStartPrice :
     locationDirection == LOC_SHORT ? baseLegValid and not na(anchorStartPrice) and not na(anchorEndPrice) and anchorStartTime < anchorEndTime and anchorStartPrice > anchorEndPrice : false

float impulseRange = anchorLegValid ? math.abs(anchorEndPrice - anchorStartPrice) : na
float impulseMid = anchorLegValid ? (anchorStartPrice + anchorEndPrice) * 0.5 : na

float fib705 = na
float fib788 = na
float fib886 = na
if anchorLegValid
    if locationDirection == LOC_LONG
        fib705 := anchorEndPrice - impulseRange * 0.705
        fib788 := anchorEndPrice - impulseRange * 0.788
        fib886 := anchorEndPrice - impulseRange * 0.886
    else if locationDirection == LOC_SHORT
        fib705 := anchorEndPrice + impulseRange * 0.705
        fib788 := anchorEndPrice + impulseRange * 0.788
        fib886 := anchorEndPrice + impulseRange * 0.886

float locationZoneTop = anchorLegValid ? math.max(fib705, fib886) : na
float locationZoneBottom = anchorLegValid ? math.min(fib705, fib886) : na
float locationTolerance = syminfo.mintick
bool hasValueMap = not na(activeVah) and not na(activeVal)

// "Impulse side" answers whether the retracement is in discount/premium relative
// to the selected impulse. This is intentionally separate from the value-map
// check below. A long can be in impulse discount and still be on the wrong side
// of auction value.
bool correctSideOfRange = anchorLegValid and (locationDirection == LOC_LONG ? fib788 < impulseMid : locationDirection == LOC_SHORT ? fib788 > impulseMid : false)

// The entire 0.705-0.886 zone must sit outside value on the directional side.
// Long: zone top (0.705) below VAL. Short: zone bottom (0.705) above VAH.
bool outsideValue = anchorLegValid and hasValueMap and (locationDirection == LOC_LONG ? locationZoneTop < activeVal - locationTolerance : locationDirection == LOC_SHORT ? locationZoneBottom > activeVah + locationTolerance : false)

f_valueSideText() =>
    string result = not hasValueMap ? "NO VALUE MAP" : not anchorLegValid or locationDirection == LOC_NONE ? "WAIT · LOCATION" : "WAIT"
    if anchorLegValid and hasValueMap
        if locationDirection == LOC_LONG
            result := locationZoneTop < activeVal - locationTolerance ? "BELOW VAL ✓" : locationZoneBottom > activeVah + locationTolerance ? "WRONG SIDE · ABOVE VAH ✕" : "OVERLAPS VALUE ✕"
        else if locationDirection == LOC_SHORT
            result := locationZoneBottom > activeVah + locationTolerance ? "ABOVE VAH ✓" : locationZoneTop < activeVal - locationTolerance ? "WRONG SIDE · BELOW VAL ✕" : "OVERLAPS VALUE ✕"
    result

string valueSideText = f_valueSideText()
bool internalSwingOk = not requireInternalSwing or hasInternalSwing15m
bool locationEligible = locationDirection != LOC_NONE and anchorLegValid and correctSideOfRange and outsideValue and internalSwingOk

// Invalidation persists for the selected anchor until a new impulse is selected.
// It is intentionally evaluated even when the value-side check rejects the zone,
// so test mode can tell us that a stale impulse has already crossed its .886 line.
var int trackedLocationDirection = LOC_NONE
var int trackedAnchorStartTime = na
var int trackedAnchorEndTime = na
var bool locationInvalidated = false

bool anchorChanged = locationDirection != trackedLocationDirection or nz(anchorStartTime, 0) != nz(trackedAnchorStartTime, 0) or nz(anchorEndTime, 0) != nz(trackedAnchorEndTime, 0)
if anchorChanged
    trackedLocationDirection := locationDirection
    trackedAnchorStartTime := anchorStartTime
    trackedAnchorEndTime := anchorEndTime
    locationInvalidated := false

if anchorLegValid and not locationInvalidated
    if locationDirection == LOC_LONG and close < fib886 - locationTolerance
        locationInvalidated := true
    else if locationDirection == LOC_SHORT and close > fib886 + locationTolerance
        locationInvalidated := true

bool candleTouchesLocation = locationEligible and high >= locationZoneBottom and low <= locationZoneTop
float approachDistance = anchorLegValid ? impulseRange * approachPct / 100.0 : na
bool approachingLocation = locationEligible and not candleTouchesLocation and not locationInvalidated and (locationDirection == LOC_LONG ? close > locationZoneTop and close <= locationZoneTop + approachDistance : locationDirection == LOC_SHORT ? close < locationZoneBottom and close >= locationZoneBottom - approachDistance : false)

f_locationBiasText() =>
    locationDirection == LOC_LONG ? "LONG" + (locationTestOverride ? " · TEST" : "") : locationDirection == LOC_SHORT ? "SHORT" + (locationTestOverride ? " · TEST" : "") : "NONE"

f_locationState() =>
    string result = "CONTEXT BLOCKED"
    if locationDirection != LOC_NONE
        result := not baseLegValid ? "LEG WARMING" :
          not anchorLegValid ? "ANCHOR INVALID" :
          locationInvalidated ? (locationDirection == LOC_LONG ? "INVALIDATED < .886" : "INVALIDATED > .886") :
          not hasValueMap ? "NO VALUE MAP" :
          not correctSideOfRange ? "WRONG IMPULSE SIDE" :
          not outsideValue ? valueSideText :
          not internalSwingOk ? "NO 15M SWING" :
          candleTouchesLocation ? (locationDirection == LOC_LONG ? "IN LONG LOCATION" : "IN SHORT LOCATION") :
          approachingLocation ? (locationDirection == LOC_LONG ? "APPROACHING LONG" : "APPROACHING SHORT") : "VALID · WAIT PULLBACK"
    result

string locationState = f_locationState()

// -----------------------------------------------------------------------------
// Phase 9.3 - full-funnel historical validation counters
// Validation mode uses production rules. These counters do not gate or alter
// trading logic; they only explain where each completed NY session stopped.
// Context PASS means the production environment resolved to a directional
// long/short bias. Location counters then follow the same ordered checks shown
// by the Location state machine.
// -----------------------------------------------------------------------------
var int valCtxPass = 0
var int valCtxBlocked = 0
var int valLocValid = 0
var int valLocInZone = 0
var int valLocApproach = 0
var int valLocLegBlocked = 0
var int valLocInvalidated = 0
var int valLocNoValue = 0
var int valLocWrongRange = 0
var int valLocWrongValueSide = 0
var int valLocNoSwing = 0
var int valParticipationPass = 0
var int valOrderflowReady = 0

if nySessionStarted
    valCtxPass := 0
    valCtxBlocked := 0
    valLocValid := 0
    valLocInZone := 0
    valLocApproach := 0
    valLocLegBlocked := 0
    valLocInvalidated := 0
    valLocNoValue := 0
    valLocWrongRange := 0
    valLocWrongValueSide := 0
    valLocNoSwing := 0
    valParticipationPass := 0
    valOrderflowReady := 0

if barstate.isconfirmed and inNyActiveSession
    bool valContextPassNow = autoLocationDirection != LOC_NONE
    if valContextPassNow
        valCtxPass += 1

        // Exclusive location stop reason, matching f_locationState() order.
        if not baseLegValid or not anchorLegValid
            valLocLegBlocked += 1
        else if locationInvalidated
            valLocInvalidated += 1
        else if not hasValueMap
            valLocNoValue += 1
        else if not correctSideOfRange
            valLocWrongRange += 1
        else if not outsideValue
            valLocWrongValueSide += 1
        else if not internalSwingOk
            valLocNoSwing += 1
        else
            valLocValid += 1
            if candleTouchesLocation
                valLocInZone += 1
            else if approachingLocation
                valLocApproach += 1
    else
        valCtxBlocked += 1

    if participationPass
        valParticipationPass += 1
    if orderflowDataReady
        valOrderflowReady += 1

// -----------------------------------------------------------------------------
// Phase 6D.1 - dominance shift + TEST-only diagnostic harness
//
// Production path (diagnostic mode OFF): unchanged from Phase 6D.
// - qualified absorption seed,
// - opposite-side 6B aggression,
// - production progress / close-location thresholds,
// - optional absorption-midpoint reclaim,
// - production lookahead,
// - location invalidation remains binding.
//
// Diagnostic path (TEST-only): designed only to exercise the state machine on
// static historical bars when a seven-day sample does not contain a natural
// production confirmation. It can:
// - use potential absorption or any aggression as a seed,
// - use opposite directional proxy delta instead of full aggression,
// - relax progress / close-location thresholds,
// - extend lookahead,
// - ignore midpoint reclaim and location invalidation.
// None of these TEST relaxations apply when dominanceDiagnosticMode is OFF.
// -----------------------------------------------------------------------------
bool dominanceTestMode = dominanceDiagnosticMode or dominanceAllowPotentialTest or dominanceBypassContextTest

bool diagnosticPotentialSeed = absorptionDetected or potentialAbsorption
bool diagnosticAnyAggressionSeed = aggressionDetected
bool diagnosticSeedEvent = dominanceDiagnosticSeedMode == "Potential Absorption" ? diagnosticPotentialSeed : diagnosticAnyAggressionSeed
int diagnosticSeedDirection = dominanceDiagnosticSeedMode == "Potential Absorption" ?
  (sellerAbsorption or sellerPotentialAbsorption ? LOC_LONG : buyerAbsorption or buyerPotentialAbsorption ? LOC_SHORT : LOC_NONE) :
  (sellerAggression ? LOC_LONG : buyerAggression ? LOC_SHORT : LOC_NONE)

bool productionAbsorptionSeed = absorptionDetected or (dominanceAllowPotentialTest and potentialAbsorption)
int productionSeedDirection = (sellerAbsorption or (dominanceAllowPotentialTest and sellerPotentialAbsorption)) ? LOC_LONG :
  (buyerAbsorption or (dominanceAllowPotentialTest and buyerPotentialAbsorption)) ? LOC_SHORT : LOC_NONE

bool dominanceAbsorptionSeed = dominanceDiagnosticMode ? diagnosticSeedEvent : productionAbsorptionSeed
int dominanceSeedDirection = dominanceDiagnosticMode ? diagnosticSeedDirection : productionSeedDirection
bool dominanceSeedContextOk = dominanceDiagnosticMode or dominanceBypassContextTest or (locationEligible and candleTouchesLocation and not locationInvalidated)

var int pendingDominanceDirection = LOC_NONE
var int pendingDominanceSeedBar = na
var float pendingDominanceMid = na
var float pendingDominanceHigh = na
var float pendingDominanceLow = na

if nySessionStarted
    pendingDominanceDirection := LOC_NONE
    pendingDominanceSeedBar := na
    pendingDominanceMid := na
    pendingDominanceHigh := na
    pendingDominanceLow := na

bool dominancePending = pendingDominanceDirection != LOC_NONE and not na(pendingDominanceSeedBar)
bool dominanceSeedQualified = inNyActiveSession and participationPass and orderflowDataReady and dominanceAbsorptionSeed and dominanceSeedDirection != LOC_NONE and dominanceSeedContextOk and (not dominanceDiagnosticMode or not dominancePending)

int effectiveDominanceLookahead = dominanceDiagnosticMode ? dominanceDiagnosticLookaheadBars : dominanceLookaheadBars
float effectiveDominanceMinProgressPct = dominanceDiagnosticMode ? dominanceDiagnosticMinProgressPct : dominanceMinProgressPct
float effectiveDominanceMinCloseLocationPct = dominanceDiagnosticMode ? dominanceDiagnosticMinCloseLocationPct : dominanceMinCloseLocationPct
bool effectiveDominanceRequireMidpoint = dominanceDiagnosticMode ? not dominanceDiagnosticIgnoreMidpoint : dominanceRequireAbsorptionMidpoint

int dominanceBarsSinceSeed = dominancePending ? bar_index - pendingDominanceSeedBar : na
bool dominanceWithinWindow = dominancePending and dominanceBarsSinceSeed >= 1 and dominanceBarsSinceSeed <= effectiveDominanceLookahead

float dominanceBarRange = math.max(high - low, syminfo.mintick)
float dominanceBuyerProgressPct = math.max(0.0, (close - open) / dominanceBarRange * 100.0)
float dominanceSellerProgressPct = math.max(0.0, (open - close) / dominanceBarRange * 100.0)
float dominanceBuyerCloseLocationPct = (close - low) / dominanceBarRange * 100.0
float dominanceSellerCloseLocationPct = (high - close) / dominanceBarRange * 100.0

bool buyerDirectionalDelta = orderflowDataReady and orderflowDeltaPct > orderflowNeutralDeltaPct
bool sellerDirectionalDelta = orderflowDataReady and orderflowDeltaPct < -orderflowNeutralDeltaPct
bool buyerOppositeFlowProof = dominanceDiagnosticMode and dominanceDiagnosticUseDirectionalDelta ? buyerDirectionalDelta : buyerAggression
bool sellerOppositeFlowProof = dominanceDiagnosticMode and dominanceDiagnosticUseDirectionalDelta ? sellerDirectionalDelta : sellerAggression

bool buyerDominanceProgress = buyerOppositeFlowProof and dominanceBuyerProgressPct >= effectiveDominanceMinProgressPct and dominanceBuyerCloseLocationPct >= effectiveDominanceMinCloseLocationPct
bool sellerDominanceProgress = sellerOppositeFlowProof and dominanceSellerProgressPct >= effectiveDominanceMinProgressPct and dominanceSellerCloseLocationPct >= effectiveDominanceMinCloseLocationPct
bool buyerMidpointReclaim = not effectiveDominanceRequireMidpoint or (not na(pendingDominanceMid) and close > pendingDominanceMid)
bool sellerMidpointReclaim = not effectiveDominanceRequireMidpoint or (not na(pendingDominanceMid) and close < pendingDominanceMid)
bool dominanceLocationStillOk = dominanceDiagnosticMode or not locationInvalidated

bool buyerDominanceCandidate = dominanceDiagnosticMode and inNyActiveSession and dominanceWithinWindow and pendingDominanceDirection == LOC_LONG and buyerOppositeFlowProof
bool sellerDominanceCandidate = dominanceDiagnosticMode and inNyActiveSession and dominanceWithinWindow and pendingDominanceDirection == LOC_SHORT and sellerOppositeFlowProof

bool buyerDominanceShift = inNyActiveSession and dominanceLocationStillOk and dominanceWithinWindow and pendingDominanceDirection == LOC_LONG and buyerDominanceProgress and buyerMidpointReclaim
bool sellerDominanceShift = inNyActiveSession and dominanceLocationStillOk and dominanceWithinWindow and pendingDominanceDirection == LOC_SHORT and sellerDominanceProgress and sellerMidpointReclaim
bool dominanceShiftDetected = buyerDominanceShift or sellerDominanceShift
// Snapshot the original failed-participant extreme before Phase 6D clears its pending seed state.
float dominanceShiftFailureExtreme = buyerDominanceShift ? pendingDominanceLow : sellerDominanceShift ? pendingDominanceHigh : na
bool dominanceExpiredThisBar = dominancePending and dominanceBarsSinceSeed > effectiveDominanceLookahead

// Event counters: these do not partition all 18 session bars.
var int domSessionSeeds = 0
var int domSessionBuyer = 0
var int domSessionSeller = 0
var int domSessionExpired = 0
var int domSessionBuyerCandidates = 0
var int domSessionSellerCandidates = 0

if nySessionStarted
    domSessionSeeds := 0
    domSessionBuyer := 0
    domSessionSeller := 0
    domSessionExpired := 0
    domSessionBuyerCandidates := 0
    domSessionSellerCandidates := 0

if barstate.isconfirmed and inNyActiveSession
    if buyerDominanceCandidate
        domSessionBuyerCandidates += 1
    if sellerDominanceCandidate
        domSessionSellerCandidates += 1
    if buyerDominanceShift
        domSessionBuyer += 1
    if sellerDominanceShift
        domSessionSeller += 1
    if dominanceExpiredThisBar
        domSessionExpired += 1

    // Evaluate before updating so the seed bar cannot confirm itself.
    if dominanceShiftDetected or dominanceExpiredThisBar or (locationInvalidated and not dominanceDiagnosticMode)
        pendingDominanceDirection := LOC_NONE
        pendingDominanceSeedBar := na
        pendingDominanceMid := na
        pendingDominanceHigh := na
        pendingDominanceLow := na

    if dominanceSeedQualified
        pendingDominanceDirection := dominanceSeedDirection
        pendingDominanceSeedBar := bar_index
        pendingDominanceMid := (high + low) * 0.5
        pendingDominanceHigh := high
        pendingDominanceLow := low
        domSessionSeeds += 1

if nySessionEnded
    pendingDominanceDirection := LOC_NONE
    pendingDominanceSeedBar := na
    pendingDominanceMid := na
    pendingDominanceHigh := na
    pendingDominanceLow := na

bool dominancePendingNow = pendingDominanceDirection != LOC_NONE and not na(pendingDominanceSeedBar)
int dominanceBarsRemaining = dominancePendingNow ? math.max(0, effectiveDominanceLookahead - (bar_index - pendingDominanceSeedBar)) : 0
string dominanceState = not inNyActiveSession ? "OUTSIDE NY" :
  buyerDominanceShift ? "BUYER SHIFT · CONFIRMED" :
  sellerDominanceShift ? "SELLER SHIFT · CONFIRMED" :
  dominancePendingNow ? (pendingDominanceDirection == LOC_LONG ? "WAIT BUYER SHIFT · " : "WAIT SELLER SHIFT · ") + str.tostring(dominanceBarsRemaining) + "B" :
  "WAIT · SEED"

bool showDomHistoryBar = showHistoricalDominance and inTestWindow and inNyActiveSession
plotshape(showDomHistoryBar and buyerDominanceShift, title="Buyer Dominance Shift", style=shape.square, location=location.belowbar, color=color.lime, size=size.tiny, display=display.pane)
plotshape(showDomHistoryBar and sellerDominanceShift, title="Seller Dominance Shift", style=shape.square, location=location.abovebar, color=color.red, size=size.tiny, display=display.pane)
plotshape(showDomHistoryBar and dominanceDiagnosticMode and showDominanceCandidates and buyerDominanceCandidate and not buyerDominanceShift, title="TEST Buyer Dominance Candidate", style=shape.circle, location=location.belowbar, color=color.new(color.aqua, 20), size=size.tiny, display=display.pane)
plotshape(showDomHistoryBar and dominanceDiagnosticMode and showDominanceCandidates and sellerDominanceCandidate and not sellerDominanceShift, title="TEST Seller Dominance Candidate", style=shape.circle, location=location.abovebar, color=color.new(color.orange, 20), size=size.tiny, display=display.pane)

if nySessionEnded and showDominanceSessionSummary and inTestWindow
    string domPrefix = dominanceDiagnosticMode ? "DOM DIAG" : "DOM PROXY"
    string candidateText = dominanceDiagnosticMode ? "  CB" + str.tostring(domSessionBuyerCandidates) + "  CS" + str.tostring(domSessionSellerCandidates) : ""
    string domSummary = domPrefix + "  Seed" + str.tostring(domSessionSeeds) + candidateText + "  B" + str.tostring(domSessionBuyer) + "  S" + str.tostring(domSessionSeller) + "  Exp" + str.tostring(domSessionExpired) + (dominanceTestMode ? "  TEST" : "")
    label.new(bar_index - 1, low[1], domSummary, xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.black, 64), textcolor=dominanceTestMode ? color.orange : color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// Phase 6E - retest + second failure + SETUP READY
//
// A confirmed dominance shift arms a setup sequence. The original failed-side
// extreme is preserved from the absorption/dominance seed. The market must then:
// 1) retest toward the dominance bar,
// 2) show the failed side trying again while holding a better extreme,
// 3) show the dominant side return within a short confirmation window.
// SETUP READY is informational only. Execution remains manual.
// -----------------------------------------------------------------------------
bool setupTestMode = setupDiagnosticMode or dominanceDiagnosticMode

var int setupDirection = LOC_NONE
var int setupDominanceBar = na
var float setupFailureExtreme = na
var float setupDominanceHigh = na
var float setupDominanceLow = na
var float setupRetestReference = na
var int setupRetestBar = na
var float setupRetestHigh = na
var float setupRetestLow = na
var float setupRetestMid = na
var bool setupRetestSeen = false
var int setupConfirmDeadline = na

// Session event counters. These count events, not all session bars.
var int setupSessionArmed = 0
var int setupSessionRetest = 0
var int setupSessionSecondFailure = 0
var int setupSessionReadyLong = 0
var int setupSessionReadyShort = 0
var int setupSessionExpired = 0

if nySessionStarted
    setupDirection := LOC_NONE
    setupDominanceBar := na
    setupFailureExtreme := na
    setupDominanceHigh := na
    setupDominanceLow := na
    setupRetestReference := na
    setupRetestBar := na
    setupRetestHigh := na
    setupRetestLow := na
    setupRetestMid := na
    setupRetestSeen := false
    setupConfirmDeadline := na
    setupSessionArmed := 0
    setupSessionRetest := 0
    setupSessionSecondFailure := 0
    setupSessionReadyLong := 0
    setupSessionReadyShort := 0
    setupSessionExpired := 0

// Phase 6D snapshots the failed-participant extreme before clearing its pending seed state.
// Phase 6E consumes that immutable series value on the dominance-confirmation bar.
bool setupArmFromLongShift = buyerDominanceShift
bool setupArmFromShortShift = sellerDominanceShift

float dominanceRangeForRetest = math.max(high - low, syminfo.mintick)
float longRetestReferenceNow = low + dominanceRangeForRetest * (retestReferencePct / 100.0)
float shortRetestReferenceNow = high - dominanceRangeForRetest * (retestReferencePct / 100.0)

if barstate.isconfirmed and inNyActiveSession and (setupArmFromLongShift or setupArmFromShortShift)
    setupDirection := setupArmFromLongShift ? LOC_LONG : LOC_SHORT
    setupDominanceBar := bar_index
    setupFailureExtreme := dominanceShiftFailureExtreme
    setupDominanceHigh := high
    setupDominanceLow := low
    setupRetestReference := setupArmFromLongShift ? longRetestReferenceNow : shortRetestReferenceNow
    setupRetestBar := na
    setupRetestHigh := na
    setupRetestLow := na
    setupRetestMid := na
    setupRetestSeen := false
    setupConfirmDeadline := na
    setupSessionArmed += 1

bool setupPending = setupDirection != LOC_NONE and not na(setupDominanceBar)
int setupBarsSinceDominance = setupPending ? bar_index - setupDominanceBar : na
bool setupWithinRetestWindow = setupPending and setupBarsSinceDominance >= 1 and setupBarsSinceDominance <= retestLookaheadBars
bool setupLocationStillOk = setupTestMode and setupDiagnosticBypassLocation ? true : not locationInvalidated

// Failed-side retry proof. Production uses full 6B aggression; TEST mode can use
// directional proxy delta so static historical samples can exercise the branch.
bool longRetryFlow = setupDiagnosticMode and setupDiagnosticUseDirectionalDelta ? sellerDirectionalDelta : sellerAggression
bool shortRetryFlow = setupDiagnosticMode and setupDiagnosticUseDirectionalDelta ? buyerDirectionalDelta : buyerAggression
bool longReturnFlow = setupDiagnosticMode and setupDiagnosticUseDirectionalDelta ? buyerDirectionalDelta : buyerAggression
bool shortReturnFlow = setupDiagnosticMode and setupDiagnosticUseDirectionalDelta ? sellerDirectionalDelta : sellerAggression

// Retest must pull back toward the dominance bar while holding a better extreme
// than the original failed participants. Long retest = sellers fail above the
// original seller-failure low. Short retest = buyers fail below the original high.
bool longBetterFailureExtreme = setupPending and setupDirection == LOC_LONG and not na(setupFailureExtreme) and low > setupFailureExtreme
bool shortBetterFailureExtreme = setupPending and setupDirection == LOC_SHORT and not na(setupFailureExtreme) and high < setupFailureExtreme
bool longRetestTouch = setupDiagnosticMode and setupDiagnosticIgnoreRetestTouch ? true : low <= setupRetestReference
bool shortRetestTouch = setupDiagnosticMode and setupDiagnosticIgnoreRetestTouch ? true : high >= setupRetestReference
bool longRetestQualified = inNyActiveSession and setupLocationStillOk and setupWithinRetestWindow and setupDirection == LOC_LONG and not setupRetestSeen and longBetterFailureExtreme and longRetestTouch and (not secondFailureRequireRetryFlow or longRetryFlow)
bool shortRetestQualified = inNyActiveSession and setupLocationStillOk and setupWithinRetestWindow and setupDirection == LOC_SHORT and not setupRetestSeen and shortBetterFailureExtreme and shortRetestTouch and (not secondFailureRequireRetryFlow or shortRetryFlow)
bool retestDetected = longRetestQualified or shortRetestQualified

if barstate.isconfirmed and retestDetected
    setupRetestSeen := true
    setupRetestBar := bar_index
    setupRetestHigh := high
    setupRetestLow := low
    setupRetestMid := (high + low) * 0.5
    setupConfirmDeadline := bar_index + secondFailureLookaheadBars
    setupSessionRetest += 1

bool secondFailurePending = setupPending and setupRetestSeen and not na(setupRetestBar) and bar_index > setupRetestBar and bar_index <= setupConfirmDeadline
float setupBarRange = math.max(high - low, syminfo.mintick)
float setupBullCloseLocationPct = (close - low) / setupBarRange * 100.0
float setupBearCloseLocationPct = (high - close) / setupBarRange * 100.0

bool longSecondFailurePrice = secondFailurePending and setupDirection == LOC_LONG and low > setupFailureExtreme and close > setupRetestMid and setupBullCloseLocationPct >= secondFailureMinCloseLocationPct
bool shortSecondFailurePrice = secondFailurePending and setupDirection == LOC_SHORT and high < setupFailureExtreme and close < setupRetestMid and setupBearCloseLocationPct >= secondFailureMinCloseLocationPct
bool setupReadyLong = inNyActiveSession and setupLocationStillOk and longSecondFailurePrice and (not secondFailureRequireReturnFlow or longReturnFlow)
bool setupReadyShort = inNyActiveSession and setupLocationStillOk and shortSecondFailurePrice and (not secondFailureRequireReturnFlow or shortReturnFlow)
bool setupReady = setupReadyLong or setupReadyShort
bool secondFailureConfirmed = setupReady

// Immutable Phase 7 snapshots. These are evaluated before Phase 6E clears its
// pending state on a READY bar, so the original failed-participant extreme is preserved.
int setupReadyDirectionSnapshot = setupReadyLong ? LOC_LONG : setupReadyShort ? LOC_SHORT : LOC_NONE
float setupReadyPriceSnapshot = setupReady ? close : na
float setupReadyFailureExtremeSnapshot = setupReady ? setupFailureExtreme : na

bool setupRetestExpired = setupPending and not setupRetestSeen and setupBarsSinceDominance > retestLookaheadBars
bool setupConfirmExpired = setupPending and setupRetestSeen and not na(setupConfirmDeadline) and bar_index > setupConfirmDeadline
bool setupInvalidated = setupPending and not setupLocationStillOk
bool setupExpiredThisBar = setupRetestExpired or setupConfirmExpired or setupInvalidated

if barstate.isconfirmed and inNyActiveSession
    if secondFailureConfirmed
        setupSessionSecondFailure += 1
        if setupReadyLong
            setupSessionReadyLong += 1
        if setupReadyShort
            setupSessionReadyShort += 1
    if setupExpiredThisBar
        setupSessionExpired += 1

    if setupReady or setupExpiredThisBar
        setupDirection := LOC_NONE
        setupDominanceBar := na
        setupFailureExtreme := na
        setupDominanceHigh := na
        setupDominanceLow := na
        setupRetestReference := na
        setupRetestBar := na
        setupRetestHigh := na
        setupRetestLow := na
        setupRetestMid := na
        setupRetestSeen := false
        setupConfirmDeadline := na

if nySessionEnded
    setupDirection := LOC_NONE
    setupDominanceBar := na
    setupFailureExtreme := na
    setupDominanceHigh := na
    setupDominanceLow := na
    setupRetestReference := na
    setupRetestBar := na
    setupRetestHigh := na
    setupRetestLow := na
    setupRetestMid := na
    setupRetestSeen := false
    setupConfirmDeadline := na

bool setupPendingNow = setupDirection != LOC_NONE and not na(setupDominanceBar)
int setupRetestBarsRemaining = setupPendingNow and not setupRetestSeen ? math.max(0, retestLookaheadBars - (bar_index - setupDominanceBar)) : 0
int setupConfirmBarsRemaining = setupPendingNow and setupRetestSeen and not na(setupConfirmDeadline) ? math.max(0, setupConfirmDeadline - bar_index) : 0

string setupState = not inNyActiveSession ? "OUTSIDE NY" :
  setupReadyLong ? "SETUP READY · LONG" :
  setupReadyShort ? "SETUP READY · SHORT" :
  setupPendingNow and setupRetestSeen ? (setupDirection == LOC_LONG ? "SECOND FAILURE · WAIT BUYERS · " : "SECOND FAILURE · WAIT SELLERS · ") + str.tostring(setupConfirmBarsRemaining) + "B" :
  setupPendingNow ? (setupDirection == LOC_LONG ? "WAIT LONG RETEST · " : "WAIT SHORT RETEST · ") + str.tostring(setupRetestBarsRemaining) + "B" :
  "WAIT · DOMINANCE"

bool showSetupHistoryBar = inTestWindow and inNyActiveSession
plotshape(showSetupHistoryBar and showHistoricalRetest and longRetestQualified, title="Long Retest", style=shape.circle, location=location.belowbar, color=color.yellow, size=size.tiny, display=display.pane)
plotshape(showSetupHistoryBar and showHistoricalRetest and shortRetestQualified, title="Short Retest", style=shape.circle, location=location.abovebar, color=color.yellow, size=size.tiny, display=display.pane)
plotshape(showSetupHistoryBar and showHistoricalRetest and setupReadyLong, title="Long Second Failure", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.tiny, display=display.pane)
plotshape(showSetupHistoryBar and showHistoricalRetest and setupReadyShort, title="Short Second Failure", style=shape.diamond, location=location.abovebar, color=color.orange, size=size.tiny, display=display.pane)
bool showSetupReadyMarkerNow = showSetupReadyMarkers and (validationVisualsEnabled or barstate.isrealtime)
plotshape(showSetupHistoryBar and showSetupReadyMarkerNow and setupReadyLong, title="SETUP READY Long", style=shape.labelup, location=location.belowbar, color=color.lime, text="READY L", textcolor=color.black, size=size.tiny, display=display.pane)
plotshape(showSetupHistoryBar and showSetupReadyMarkerNow and setupReadyShort, title="SETUP READY Short", style=shape.labeldown, location=location.abovebar, color=color.red, text="READY S", textcolor=color.white, size=size.tiny, display=display.pane)

alertcondition(setupReadyLong, title="WorldChamp SETUP READY Long", message="WorldChamp: LONG setup ready. Manual execution only.")
alertcondition(setupReadyShort, title="WorldChamp SETUP READY Short", message="WorldChamp: SHORT setup ready. Manual execution only.")

if nySessionEnded and showSetupSessionSummary and inTestWindow
    string setupPrefix = setupDiagnosticMode ? "SETUP DIAG" : "SETUP PROXY"
    string setupSummary = setupPrefix + "  Arm" + str.tostring(setupSessionArmed) + "  Ret" + str.tostring(setupSessionRetest) + "  SF" + str.tostring(setupSessionSecondFailure) + "  L" + str.tostring(setupSessionReadyLong) + "  S" + str.tostring(setupSessionReadyShort) + "  Exp" + str.tostring(setupSessionExpired) + (setupTestMode ? "  TEST" : "")
    label.new(bar_index - 1, low[1], setupSummary, xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.black, 60), textcolor=setupTestMode ? color.orange : color.white, size=size.tiny)

// Phase 9.3: one full-funnel session summary in Validation mode. Individual
// module summaries remain available only in Debug mode.
if nySessionEnded and validationMode and inTestWindow
    int valBars = valCtxPass + valCtxBlocked
    string valLine1 = "WC VAL · " + str.tostring(valBars) + "B | CTX P" + str.tostring(valCtxPass) + " B" + str.tostring(valCtxBlocked) + " | LOC V" + str.tostring(valLocValid) + " Z" + str.tostring(valLocInZone) + " A" + str.tostring(valLocApproach)
    string valLine2 = "BLK LEG" + str.tostring(valLocLegBlocked) + " INV" + str.tostring(valLocInvalidated) + " MAP" + str.tostring(valLocNoValue) + " RNG" + str.tostring(valLocWrongRange) + " VAL" + str.tostring(valLocWrongValueSide) + " SW" + str.tostring(valLocNoSwing)
    string valLine3 = "PART P" + str.tostring(valParticipationPass) + " H" + str.tostring(partSessionHigh) + " N" + str.tostring(partSessionNormal) + " L" + str.tostring(partSessionLow) + " | OF " + str.tostring(valOrderflowReady) + "/" + str.tostring(valBars) + " | AGG B" + str.tostring(aggSessionBuy) + " S" + str.tostring(aggSessionSell)
    string valLine4 = "ABS SA" + str.tostring(absSessionSeller) + " BA" + str.tostring(absSessionBuyer) + " P" + str.tostring(absSessionPotential) + " | DOM B" + str.tostring(domSessionBuyer) + " S" + str.tostring(domSessionSeller) + " E" + str.tostring(domSessionExpired) + " | SET L" + str.tostring(setupSessionReadyLong) + " S" + str.tostring(setupSessionReadyShort)
    string valSummary = valLine1 + "\n" + valLine2 + "\n" + valLine3 + "\n" + valLine4
    label.new(bar_index - 1, high[1], valSummary, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.black, 48), textcolor=color.orange, size=size.tiny)

// -----------------------------------------------------------------------------
// Phase 7 - invalidation + structural target map
//
// The map is created only when Phase 6E reaches SETUP READY. `planEntryRef` is the
// close of the READY candle and is NOT an executed trade price. The primary
// invalidation is the original failed-participant extreme, matching the thesis:
// if those participants regain control through their failure point, the idea is wrong.
// Targets are selected only from existing structural/context levels in the setup
// direction. No arbitrary profit target is invented when structure is absent.
// -----------------------------------------------------------------------------
f_addPlanTarget(array<float> levels, array<string> names, float level, string name, float entryRef, int direction) =>
    bool directional = not na(level) and not na(entryRef) and (direction == LOC_LONG ? level > entryRef + syminfo.mintick : direction == LOC_SHORT ? level < entryRef - syminfo.mintick : false)
    if directional
        bool duplicate = false
        int n = array.size(levels)
        if n > 0
            for i = 0 to n - 1
                duplicate := duplicate or math.abs(array.get(levels, i) - level) <= syminfo.mintick * 2.0
        if not duplicate
            array.push(levels, level)
            array.push(names, name)
    array.size(levels)

f_sortPlanTargets(array<float> levels, array<string> names, int direction) =>
    int n = array.size(levels)
    if n > 1
        for i = 0 to n - 2
            int best = i
            for j = i + 1 to n - 1
                float candidate = array.get(levels, j)
                float incumbent = array.get(levels, best)
                bool better = direction == LOC_LONG ? candidate < incumbent : candidate > incumbent
                if better
                    best := j
            if best != i
                float levelAtI = array.get(levels, i)
                float levelAtBest = array.get(levels, best)
                string nameAtI = array.get(names, i)
                string nameAtBest = array.get(names, best)
                array.set(levels, i, levelAtBest)
                array.set(levels, best, levelAtI)
                array.set(names, i, nameAtBest)
                array.set(names, best, nameAtI)
    n

f_planR(float target, float entryRef, float invalidation) =>
    float risk = not na(entryRef) and not na(invalidation) ? math.abs(entryRef - invalidation) : na
    not na(target) and not na(risk) and risk > syminfo.mintick ? math.abs(target - entryRef) / risk : na

f_bestPlanR(float r1, float r2, float r3) =>
    float best = na
    if not na(r1)
        best := r1
    if not na(r2)
        best := na(best) ? r2 : math.max(best, r2)
    if not na(r3)
        best := na(best) ? r3 : math.max(best, r3)
    best

f_planQualityText(float bestR) =>
    na(bestR) ? "NO TARGET" : bestR < 1.0 ? "POOR" : bestR < 1.5 ? "MARGINAL" : bestR < 2.0 ? "GOOD" : "STRONG"

f_planQualityColor(string quality) =>
    quality == "STRONG" ? color.lime : quality == "GOOD" ? color.aqua : quality == "MARGINAL" ? color.orange : quality == "POOR" ? color.red : color.silver

var bool planExists = false
var bool planActive = false
var int planDirection = LOC_NONE
var int planStartBar = na
var float planEntryRef = na
var float planInvalidation = na
var string planT1Name = ""
var string planT2Name = ""
var string planT3Name = ""
var float planT1 = na
var float planT2 = na
var float planT3 = na
var bool planT1Touched = false
var bool planT2Touched = false
var bool planT3Touched = false
var bool planInvalidationTouched = false
var float planBestAvailableR = na
var string planQuality = "WAIT"
var bool planQualityPass = false

var line planEntryLine = na
var line planInvalidationLine = na
var line planT1Line = na
var line planT2Line = na
var line planT3Line = na
var label planEntryLabel = na
var label planInvalidationLabel = na
var label planT1Label = na
var label planT2Label = na
var label planT3Label = na

if barstate.isconfirmed and setupReady and not na(setupReadyPriceSnapshot) and not na(setupReadyFailureExtremeSnapshot)
    planExists := true
    planActive := true
    planDirection := setupReadyDirectionSnapshot
    planStartBar := bar_index
    planEntryRef := setupReadyPriceSnapshot
    planInvalidation := setupReadyDirectionSnapshot == LOC_LONG ? setupReadyFailureExtremeSnapshot - invalidationBufferTicks * syminfo.mintick : setupReadyFailureExtremeSnapshot + invalidationBufferTicks * syminfo.mintick
    planT1Touched := false
    planT2Touched := false
    planT3Touched := false
    planInvalidationTouched := false

    array<float> targetLevels = array.new_float()
    array<string> targetNames = array.new_string()

    if includeValueTargets
        f_addPlanTarget(targetLevels, targetNames, activePoc, "POC", planEntryRef, planDirection)
        f_addPlanTarget(targetLevels, targetNames, planDirection == LOC_LONG ? activeVah : activeVal, planDirection == LOC_LONG ? "VAH" : "VAL", planEntryRef, planDirection)
        f_addPlanTarget(targetLevels, targetNames, referencePoc, "PRIOR POC", planEntryRef, planDirection)
        f_addPlanTarget(targetLevels, targetNames, planDirection == LOC_LONG ? referenceVal : referenceVah, planDirection == LOC_LONG ? "PRIOR VAL" : "PRIOR VAH", planEntryRef, planDirection)
        f_addPlanTarget(targetLevels, targetNames, planDirection == LOC_LONG ? referenceVah : referenceVal, planDirection == LOC_LONG ? "PRIOR VAH" : "PRIOR VAL", planEntryRef, planDirection)

    if includeStructureTargets
        f_addPlanTarget(targetLevels, targetNames, planDirection == LOC_LONG ? lastHigh1h : lastLow1h, planDirection == LOC_LONG ? "1H SH" : "1H SL", planEntryRef, planDirection)
        f_addPlanTarget(targetLevels, targetNames, planDirection == LOC_LONG ? lastHigh4h : lastLow4h, planDirection == LOC_LONG ? "4H SH" : "4H SL", planEntryRef, planDirection)

    if includeGexWallTarget
        f_addPlanTarget(targetLevels, targetNames, planDirection == LOC_LONG ? callWall : putWall, planDirection == LOC_LONG ? "CALL WALL" : "PUT WALL", planEntryRef, planDirection)

    f_sortPlanTargets(targetLevels, targetNames, planDirection)
    int targetCount = array.size(targetLevels)
    planT1 := targetCount > 0 ? array.get(targetLevels, 0) : na
    planT1Name := targetCount > 0 ? array.get(targetNames, 0) : ""
    planT2 := targetCount > 1 ? array.get(targetLevels, 1) : na
    planT2Name := targetCount > 1 ? array.get(targetNames, 1) : ""
    planT3 := targetCount > 2 ? array.get(targetLevels, 2) : na
    planT3Name := targetCount > 2 ? array.get(targetNames, 2) : ""

    float newT1R = f_planR(planT1, planEntryRef, planInvalidation)
    float newT2R = f_planR(planT2, planEntryRef, planInvalidation)
    float newT3R = f_planR(planT3, planEntryRef, planInvalidation)
    planBestAvailableR := f_bestPlanR(newT1R, newT2R, newT3R)
    planQuality := f_planQualityText(planBestAvailableR)
    planQualityPass := not na(planBestAvailableR) and planBestAvailableR >= minimumActionableR

    if not na(planEntryLine)
        line.delete(planEntryLine)
    if not na(planInvalidationLine)
        line.delete(planInvalidationLine)
    if not na(planT1Line)
        line.delete(planT1Line)
    if not na(planT2Line)
        line.delete(planT2Line)
    if not na(planT3Line)
        line.delete(planT3Line)
    if not na(planEntryLabel)
        label.delete(planEntryLabel)
    if not na(planInvalidationLabel)
        label.delete(planInvalidationLabel)
    if not na(planT1Label)
        label.delete(planT1Label)
    if not na(planT2Label)
        label.delete(planT2Label)
    if not na(planT3Label)
        label.delete(planT3Label)

    if showTradeMap
        int mapEnd = bar_index + planExtendBars
        planEntryLine := line.new(bar_index, planEntryRef, mapEnd, planEntryRef, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.white, 55), style=line.style_dotted, width=1)
        planInvalidationLine := line.new(bar_index, planInvalidation, mapEnd, planInvalidation, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 5), style=line.style_solid, width=2)
        if not na(planT1)
            planT1Line := line.new(bar_index, planT1, mapEnd, planT1, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.aqua, 10), style=line.style_solid, width=1)
        else
            planT1Line := na
        if not na(planT2)
            planT2Line := line.new(bar_index, planT2, mapEnd, planT2, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.aqua, 30), style=line.style_dashed, width=1)
        else
            planT2Line := na
        if not na(planT3)
            planT3Line := line.new(bar_index, planT3, mapEnd, planT3, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.aqua, 50), style=line.style_dotted, width=1)
        else
            planT3Line := na

        if showTradeMapLabels
            float t1R = f_planR(planT1, planEntryRef, planInvalidation)
            float t2R = f_planR(planT2, planEntryRef, planInvalidation)
            float t3R = f_planR(planT3, planEntryRef, planInvalidation)
            string r1 = showTargetR and not na(t1R) ? " · " + str.tostring(t1R, "#.2") + "R" : ""
            string r2 = showTargetR and not na(t2R) ? " · " + str.tostring(t2R, "#.2") + "R" : ""
            string r3 = showTargetR and not na(t3R) ? " · " + str.tostring(t3R, "#.2") + "R" : ""
            string readyQualityText = showPlanQualityOnReadyLabel ? " · " + planQuality + (not na(planBestAvailableR) ? " · " + str.tostring(planBestAvailableR, "#.2") + "R" : "") : ""
            planEntryLabel := label.new(mapEnd, planEntryRef, "READY REF" + readyQualityText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 65), textcolor=f_planQualityColor(planQuality), size=size.tiny)
            planInvalidationLabel := label.new(mapEnd, planInvalidation, "INV · FAILED SIDE", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)
            if not na(planT1)
                planT1Label := label.new(mapEnd, planT1, "T1 " + planT1Name + r1, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.aqua, 80), textcolor=color.white, size=size.tiny)
            if not na(planT2)
                planT2Label := label.new(mapEnd, planT2, "T2 " + planT2Name + r2, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.aqua, 85), textcolor=color.white, size=size.tiny)
            if not na(planT3)
                planT3Label := label.new(mapEnd, planT3, "T3 " + planT3Name + r3, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.aqua, 90), textcolor=color.white, size=size.tiny)

if planExists and barstate.isconfirmed and not na(planStartBar) and bar_index > planStartBar
    if planDirection == LOC_LONG
        planInvalidationTouched := planInvalidationTouched or low <= planInvalidation
        planT1Touched := planT1Touched or (not na(planT1) and high >= planT1)
        planT2Touched := planT2Touched or (not na(planT2) and high >= planT2)
        planT3Touched := planT3Touched or (not na(planT3) and high >= planT3)
    else if planDirection == LOC_SHORT
        planInvalidationTouched := planInvalidationTouched or high >= planInvalidation
        planT1Touched := planT1Touched or (not na(planT1) and low <= planT1)
        planT2Touched := planT2Touched or (not na(planT2) and low <= planT2)
        planT3Touched := planT3Touched or (not na(planT3) and low <= planT3)

    bool finalTargetTouched = not na(planT3) ? planT3Touched : not na(planT2) ? planT2Touched : not na(planT1) ? planT1Touched : false
    if planInvalidationTouched or finalTargetTouched
        planActive := false

string planStatus = not planExists ? "WAIT · SETUP READY" :
  planInvalidationTouched ? "INV TOUCHED" :
  planT3Touched ? "T3 TOUCHED" :
  planT2Touched ? "T2 TOUCHED" :
  planT1Touched ? "T1 TOUCHED" :
  planActive ? "MAP ACTIVE" : "MAP COMPLETE"

f_planDirectionText() =>
    planDirection == LOC_LONG ? "LONG" : planDirection == LOC_SHORT ? "SHORT" : "NONE"

f_planTargetText(string name, float level, bool touched, float entryRef, float invalidation) =>
    if na(level)
        "n/a"
    else
        float r = f_planR(level, entryRef, invalidation)
        string rText = showTargetR and not na(r) ? " · " + str.tostring(r, "#.2") + "R" : ""
        name + " " + str.tostring(level, format.mintick) + rText + (touched ? " ✓" : "")

// -----------------------------------------------------------------------------
// Phase 8/9 - plan-quality filter + post-READY management watch
//
// This remains decision support only. WorldChamp does not know whether the user
// actually entered at READY REF, so the management layer is explicitly a WATCH
// anchored to the latest READY map, not broker-position management.
// -----------------------------------------------------------------------------
bool managementSessionOk = not managementOnlyNyWindow or inNyActiveSession
bool managementWatchActive = enableManagementWatch and planExists and planActive and not planInvalidationTouched and not na(planStartBar) and bar_index > planStartBar and managementSessionOk

// Rebuild aggression from the underlying proxy so the management layer stays
// logically independent from the Phase 6 entry-sequence state machine.
bool managementBuyerAggression = managementWatchActive and orderflowDataReady and not na(orderflowDeltaPct) and orderflowDeltaPct >= aggressionThresholdPct
bool managementSellerAggression = managementWatchActive and orderflowDataReady and not na(orderflowDeltaPct) and orderflowDeltaPct <= -aggressionThresholdPct
float managementDirectionalProgressPct = managementBuyerAggression ? buyerDirectionalProgressPct : managementSellerAggression ? sellerDirectionalProgressPct : na
float managementCounterRecoveryPct = managementBuyerAggression ? buyerCounterRecoveryPct : managementSellerAggression ? sellerCounterRecoveryPct : na
float managementRejectionWickPct = managementBuyerAggression ? upperWickPct : managementSellerAggression ? lowerWickPct : na
bool managementPoorProgress = (managementBuyerAggression or managementSellerAggression) and not na(managementDirectionalProgressPct) and managementDirectionalProgressPct <= absorptionMaxProgressPct
bool managementRecoveredClose = (managementBuyerAggression or managementSellerAggression) and not na(managementCounterRecoveryPct) and managementCounterRecoveryPct >= absorptionMinRecoveryPct
bool managementRejectionWick = (managementBuyerAggression or managementSellerAggression) and not na(managementRejectionWickPct) and managementRejectionWickPct >= absorptionMinWickPct
int managementEffortScore = (managementBuyerAggression or managementSellerAggression) ? (managementPoorProgress ? 1 : 0) + (managementRecoveredClose ? 1 : 0) + (managementRejectionWick ? 1 : 0) : 0

bool longOwnSideEffortFailure = managementWatchActive and planDirection == LOC_LONG and managementBuyerAggression and managementEffortScore == 3
bool shortOwnSideEffortFailure = managementWatchActive and planDirection == LOC_SHORT and managementSellerAggression and managementEffortScore == 3
bool managementOwnSideEffortFailure = longOwnSideEffortFailure or shortOwnSideEffortFailure
bool longOwnSidePotentialFailure = managementUsePotentialFailure and managementWatchActive and planDirection == LOC_LONG and managementBuyerAggression and managementEffortScore == 2
bool shortOwnSidePotentialFailure = managementUsePotentialFailure and managementWatchActive and planDirection == LOC_SHORT and managementSellerAggression and managementEffortScore == 2
bool managementOwnSidePotentialFailure = longOwnSidePotentialFailure or shortOwnSidePotentialFailure

// Opposite-side aggression with real directional progress is a stronger warning
// than simple adverse delta. It says the other side is producing result, not just effort.
bool managementLongAdverseFollowThrough = managementWatchActive and planDirection == LOC_LONG and managementSellerAggression and sellerDirectionalProgressPct >= managementAdverseMinProgressPct and dominanceSellerCloseLocationPct >= managementAdverseMinClosePct
bool managementShortAdverseFollowThrough = managementWatchActive and planDirection == LOC_SHORT and managementBuyerAggression and buyerDirectionalProgressPct >= managementAdverseMinProgressPct and dominanceBuyerCloseLocationPct >= managementAdverseMinClosePct
bool managementAdverseFollowThrough = managementLongAdverseFollowThrough or managementShortAdverseFollowThrough

bool planInvalidationJustTouched = planInvalidationTouched and not planInvalidationTouched[1]
bool planT1JustTouched = planT1Touched and not planT1Touched[1]
bool planT2JustTouched = planT2Touched and not planT2Touched[1]
bool planT3JustTouched = planT3Touched and not planT3Touched[1]

string planQualityGate = not planExists ? "WAIT" : not na(planBestAvailableR) ? (planQualityPass ? "PASS · " + str.tostring(planBestAvailableR, "#.2") + "R" : "FAIL · " + str.tostring(planBestAvailableR, "#.2") + "R") : "FAIL · NO TARGET"
string managementState = not enableManagementWatch ? "OFF" :
  not planExists ? "WAIT · READY MAP" :
  planInvalidationTouched ? "THESIS FAILED · INV" :
  planT3Touched ? "TARGET MAP COMPLETE · T3" :
  (na(planT3) and planT2Touched) ? "TARGET MAP COMPLETE · T2" :
  (na(planT3) and na(planT2) and planT1Touched) ? "TARGET MAP COMPLETE · T1" :
  managementOnlyNyWindow and not inNyActiveSession ? "OUTSIDE NY · PRICE MAP ONLY" :
  managementAdverseFollowThrough ? "WARNING · OPPOSITE FOLLOW-THROUGH" :
  managementOwnSideEffortFailure ? (planDirection == LOC_LONG ? "WARNING · BUYER EFFORT FAILING" : "WARNING · SELLER EFFORT FAILING") :
  managementOwnSidePotentialFailure ? (planDirection == LOC_LONG ? "CAUTION · BUYER EFFORT STALL" : "CAUTION · SELLER EFFORT STALL") :
  planActive ? "WATCH · HEALTHY" : "MAP COMPLETE"

f_managementColor() =>
    str.contains(managementState, "THESIS FAILED") or str.contains(managementState, "WARNING") ? color.red :
     str.contains(managementState, "CAUTION") ? color.orange :
     str.contains(managementState, "HEALTHY") or str.contains(managementState, "TARGET MAP COMPLETE") ? color.lime : color.silver

plotshape(showManagementMarkers and (validationVisualsEnabled or barstate.isrealtime) and longOwnSidePotentialFailure, title="Long Mgmt Buyer Effort Stall", style=shape.circle, location=location.abovebar, color=color.yellow, size=size.tiny, text="B?", textcolor=color.black, display=display.pane)
plotshape(showManagementMarkers and (validationVisualsEnabled or barstate.isrealtime) and shortOwnSidePotentialFailure, title="Short Mgmt Seller Effort Stall", style=shape.circle, location=location.belowbar, color=color.yellow, size=size.tiny, text="S?", textcolor=color.black, display=display.pane)
plotshape(showManagementMarkers and (validationVisualsEnabled or barstate.isrealtime) and longOwnSideEffortFailure, title="Long Mgmt Buyer Effort Failing", style=shape.flag, location=location.abovebar, color=color.red, size=size.tiny, text="B!", textcolor=color.white, display=display.pane)
plotshape(showManagementMarkers and (validationVisualsEnabled or barstate.isrealtime) and shortOwnSideEffortFailure, title="Short Mgmt Seller Effort Failing", style=shape.flag, location=location.belowbar, color=color.red, size=size.tiny, text="S!", textcolor=color.white, display=display.pane)
plotshape(showManagementMarkers and (validationVisualsEnabled or barstate.isrealtime) and managementLongAdverseFollowThrough, title="Long Mgmt Seller Follow Through", style=shape.diamond, location=location.abovebar, color=color.red, size=size.small, text="ADV", textcolor=color.white, display=display.pane)
plotshape(showManagementMarkers and (validationVisualsEnabled or barstate.isrealtime) and managementShortAdverseFollowThrough, title="Short Mgmt Buyer Follow Through", style=shape.diamond, location=location.belowbar, color=color.red, size=size.small, text="ADV", textcolor=color.white, display=display.pane)

alertcondition(setupReadyLong and planQualityPass, title="WorldChamp LONG plan quality pass", message="WorldChamp: LONG setup ready with structural R meeting the configured minimum. Manual execution only.")
alertcondition(setupReadyShort and planQualityPass, title="WorldChamp SHORT plan quality pass", message="WorldChamp: SHORT setup ready with structural R meeting the configured minimum. Manual execution only.")
alertcondition(managementOwnSideEffortFailure, title="WorldChamp dominant-side effort failing", message="WorldChamp management watch: the setup's dominant side is aggressive but producing poor price result. Review the manual position if one was taken.")
alertcondition(managementAdverseFollowThrough, title="WorldChamp adverse follow-through", message="WorldChamp management watch: the opposite side is showing aggressive directional follow-through. Review the manual position if one was taken.")
alertcondition(planInvalidationJustTouched, title="WorldChamp plan invalidation touched", message="WorldChamp plan map: the failed-participant invalidation level was touched. Thesis failed for the latest READY map.")

// Phase 9 integration gate. Execution remains manual.
bool locationReadyForFlow = locationEligible and candleTouchesLocation and not locationInvalidated
bool flowGateReady = setupReady
string orderflowState = setupReadyLong ? "SETUP READY · LONG" :
  setupReadyShort ? "SETUP READY · SHORT" :
  setupPendingNow and setupRetestSeen ? "WAIT · SECOND FAILURE" :
  setupPendingNow ? "WAIT · RETEST" :
  dominanceShiftDetected ? (buyerDominanceShift ? "DOMINANCE · BUYERS" : "DOMINANCE · SELLERS") :
  dominancePendingNow ? (pendingDominanceDirection == LOC_LONG ? "WAIT · BUYER SHIFT" : "WAIT · SELLER SHIFT") :
  not locationReadyForFlow and not dominanceBypassContextTest and not dominanceDiagnosticMode ? "GATED · LOCATION" :
  not inNyActiveSession ? "GATED · SESSION" :
  not participationPass ? "GATED · VOLUME" :
  not orderflowDataReady ? "GATED · OF DATA" :
  not aggressionDetected ? "WAIT · AGGRESSION" :
  absorptionDetected ? (sellerAbsorption ? "ABSORPTION · SELLERS" : "ABSORPTION · BUYERS") :
  potentialAbsorption ? "WATCH · POTENTIAL ABS" : "AGGRESSION · RESULT OK"
string masterState = setupDiagnosticMode ? "P9.3 · SETUP DIAG" : "P9.3 · " + str.upper(operatingModeInput) + " · MANUAL"

// -----------------------------------------------------------------------------
// Clean chart visuals
// -----------------------------------------------------------------------------
color sessionShade = color.new(color.teal, 92)
bgcolor(shadeActiveSession and inTestWindow and inNyActiveSession ? sessionShade : na, title="NY active window")

// Debug HTF closes. `display.pane` keeps values out of the status line/price scale.
plot(debugMode and debugPlotHTF and inTestWindow ? close4h : na, "Confirmed 4H close", color=color.new(color.blue, 35), linewidth=2, style=plot.style_stepline, display=display.pane)
plot(debugMode and debugPlotHTF and inTestWindow ? close1h : na, "Confirmed 1H close", color=color.new(color.orange, 45), linewidth=1, style=plot.style_stepline, display=display.pane)
plot(debugMode and debugPlotHTF and inTestWindow ? close15m : na, "Confirmed 15M close", color=color.new(color.gray, 55), linewidth=1, style=plot.style_stepline, display=display.pane)

plotshape(debugMode and inTestWindow and nySessionStarted, title="NY window start", style=shape.circle, location=location.bottom, size=size.tiny, color=color.new(color.green, 0), text="NY", display=display.pane)
plotshape(debugMode and inTestWindow and nySessionEnded, title="NY window end", style=shape.circle, location=location.bottom, size=size.tiny, color=color.new(color.red, 0), text="END", display=display.pane)
plotshape(debugMode and debugPlotWindowStart and useTestWindow and time >= windowStart and time[1] < windowStart, title="Test window start", style=shape.flag, location=location.top, size=size.tiny, color=color.new(color.yellow, 0), text="7D", display=display.pane)

// -----------------------------------------------------------------------------
// Latest structural level objects
// Only four active lines are maintained; no historical line accumulation.
// -----------------------------------------------------------------------------
var line line4hHigh = na
var line line4hLow = na
var line line1hHigh = na
var line line1hLow = na

var label label4hHigh = na
var label label4hLow = na
var label label1hHigh = na
var label label1hLow = na

f_updateLevelLine(line id, int pivotTime, float price, color lineColor, string lineStyleName) =>
    line result = id
    if not na(pivotTime) and not na(price)
        lineStyle = lineStyleName == "dashed" ? line.style_dashed : line.style_dotted
        if na(result)
            result := line.new(pivotTime, price, time, price, xloc=xloc.bar_time, extend=extend.right, color=lineColor, style=lineStyle, width=1)
        else
            line.set_xy1(result, pivotTime, price)
            line.set_xy2(result, time, price)
            line.set_extend(result, extend.right)
            line.set_color(result, lineColor)
            line.set_style(result, lineStyle)
    result

f_updateLevelLabel(label id, float price, string txt, color textColor) =>
    label result = id
    if not na(price)
        if na(result)
            result := label.new(bar_index + 2, price, txt, xloc=xloc.bar_index, style=label.style_none, textcolor=textColor, size=size.tiny)
        else
            label.set_x(result, bar_index + 2)
            label.set_y(result, price)
            label.set_text(result, txt)
            label.set_textcolor(result, textColor)
    result

if barstate.islast
    if showStructureLevels
        line4hHigh := f_updateLevelLine(line4hHigh, lastHighTime4h, lastHigh4h, color.new(color.blue, 35), "dashed")
        line4hLow := f_updateLevelLine(line4hLow, lastLowTime4h, lastLow4h, color.new(color.blue, 35), "dashed")
        line1hHigh := f_updateLevelLine(line1hHigh, lastHighTime1h, lastHigh1h, color.new(color.gray, 45), "dotted")
        line1hLow := f_updateLevelLine(line1hLow, lastLowTime1h, lastLow1h, color.new(color.gray, 45), "dotted")
    else
        if not na(line4hHigh)
            line.delete(line4hHigh)
            line4hHigh := na
        if not na(line4hLow)
            line.delete(line4hLow)
            line4hLow := na
        if not na(line1hHigh)
            line.delete(line1hHigh)
            line1hHigh := na
        if not na(line1hLow)
            line.delete(line1hLow)
            line1hLow := na

    if showStructureLevels and showSwingLabels
        label4hHigh := f_updateLevelLabel(label4hHigh, lastHigh4h, "4H SH", color.new(color.blue, 0))
        label4hLow := f_updateLevelLabel(label4hLow, lastLow4h, "4H SL", color.new(color.blue, 0))
        label1hHigh := f_updateLevelLabel(label1hHigh, lastHigh1h, "1H SH", color.new(color.gray, 0))
        label1hLow := f_updateLevelLabel(label1hLow, lastLow1h, "1H SL", color.new(color.gray, 0))
    else
        if not na(label4hHigh)
            label.delete(label4hHigh)
            label4hHigh := na
        if not na(label4hLow)
            label.delete(label4hLow)
            label4hLow := na
        if not na(label1hHigh)
            label.delete(label1hHigh)
            label1hHigh := na
        if not na(label1hLow)
            label.delete(label1hLow)
            label1hLow := na

// -----------------------------------------------------------------------------
// Active value-map objects
// Only three live profile lines are maintained in normal mode.
// -----------------------------------------------------------------------------
var line lineVah = na
var line linePoc = na
var line lineVal = na
var label labelVah = na
var label labelPoc = na
var label labelVal = na

f_updateProfileLine(line id, int startTime, float price, color lineColor, string styleName, int widthValue) =>
    line result = id
    lineStyle = styleName == "dotted" ? line.style_dotted : styleName == "dashed" ? line.style_dashed : line.style_solid
    if not na(startTime) and not na(price)
        if na(result)
            result := line.new(startTime, price, time, price, xloc=xloc.bar_time, extend=extend.right, color=lineColor, style=lineStyle, width=widthValue)
        else
            line.set_xy1(result, startTime, price)
            line.set_xy2(result, time, price)
            line.set_extend(result, extend.right)
            line.set_color(result, lineColor)
            line.set_style(result, lineStyle)
            line.set_width(result, widthValue)
    result

f_updateProfileLabel(label id, float price, string txt, color textColor) =>
    label result = id
    if not na(price)
        if na(result)
            result := label.new(bar_index + 2, price, txt, xloc=xloc.bar_index, style=label.style_none, textcolor=textColor, size=size.tiny)
        else
            label.set_x(result, bar_index + 2)
            label.set_y(result, price)
            label.set_text(result, txt)
            label.set_textcolor(result, textColor)
    result

if barstate.islast
    if showValueLevels and not na(activeVah) and not na(activePoc) and not na(activeVal)
        lineVah := f_updateProfileLine(lineVah, activeMapStart, activeVah, color.new(color.aqua, 20), "solid", 1)
        linePoc := f_updateProfileLine(linePoc, activeMapStart, activePoc, color.new(color.yellow, 25), "dotted", 2)
        lineVal := f_updateProfileLine(lineVal, activeMapStart, activeVal, color.new(color.aqua, 20), "solid", 1)
    else
        if not na(lineVah)
            line.delete(lineVah)
            lineVah := na
        if not na(linePoc)
            line.delete(linePoc)
            linePoc := na
        if not na(lineVal)
            line.delete(lineVal)
            lineVal := na

    if showValueLevels and showValueLabels and not na(activeVah) and not na(activePoc) and not na(activeVal)
        labelVah := f_updateProfileLabel(labelVah, activeVah, "VAH", color.aqua)
        labelPoc := f_updateProfileLabel(labelPoc, activePoc, "POC", color.yellow)
        labelVal := f_updateProfileLabel(labelVal, activeVal, "VAL", color.aqua)
    else
        if not na(labelVah)
            label.delete(labelVah)
            labelVah := na
        if not na(labelPoc)
            label.delete(labelPoc)
            labelPoc := na
        if not na(labelVal)
            label.delete(labelVal)
            labelVal := na

// -----------------------------------------------------------------------------
// GEX level objects
// Manual levels are optional and deliberately minimal.
// -----------------------------------------------------------------------------
var line lineGammaFlip = na
var line lineCallWall = na
var line linePutWall = na
var label labelGammaFlip = na
var label labelCallWall = na
var label labelPutWall = na

f_updateGexLine(line id, float price, color lineColor, string styleName) =>
    line result = id
    lineStyle = styleName == "dashed" ? line.style_dashed : line.style_dotted
    if not na(price)
        if na(result)
            result := line.new(bar_index, price, bar_index + 1, price, xloc=xloc.bar_index, extend=extend.right, color=lineColor, style=lineStyle, width=1)
        else
            line.set_xy1(result, bar_index, price)
            line.set_xy2(result, bar_index + 1, price)
            line.set_extend(result, extend.right)
            line.set_color(result, lineColor)
            line.set_style(result, lineStyle)
    result

f_updateGexLabel(label id, float price, string txt, color textColor) =>
    label result = id
    if not na(price)
        if na(result)
            result := label.new(bar_index + 2, price, txt, xloc=xloc.bar_index, style=label.style_none, textcolor=textColor, size=size.tiny)
        else
            label.set_x(result, bar_index + 2)
            label.set_y(result, price)
            label.set_text(result, txt)
            label.set_textcolor(result, textColor)
    result

if barstate.islast
    if gexConfigured and showGexLevels
        lineGammaFlip := f_updateGexLine(lineGammaFlip, gammaFlip, color.new(color.purple, 20), "dashed")
        lineCallWall := f_updateGexLine(lineCallWall, callWall, color.new(color.green, 45), "dotted")
        linePutWall := f_updateGexLine(linePutWall, putWall, color.new(color.red, 45), "dotted")
    else
        if not na(lineGammaFlip)
            line.delete(lineGammaFlip)
            lineGammaFlip := na
        if not na(lineCallWall)
            line.delete(lineCallWall)
            lineCallWall := na
        if not na(linePutWall)
            line.delete(linePutWall)
            linePutWall := na

    if gexConfigured and showGexLevels and showGexLabels
        labelGammaFlip := f_updateGexLabel(labelGammaFlip, gammaFlip, "GAMMA FLIP", color.purple)
        labelCallWall := f_updateGexLabel(labelCallWall, callWall, "CALL WALL", color.green)
        labelPutWall := f_updateGexLabel(labelPutWall, putWall, "PUT WALL", color.red)
    else
        if not na(labelGammaFlip)
            label.delete(labelGammaFlip)
            labelGammaFlip := na
        if not na(labelCallWall)
            label.delete(labelCallWall)
            labelCallWall := na
        if not na(labelPutWall)
            label.delete(labelPutWall)
            labelPutWall := na

// -----------------------------------------------------------------------------
// Location-map objects
// One active impulse line, one shaded zone, and three Fib levels are maintained.
// ----------------------------------------------------------------------------
var line lineImpulse = na
var line lineFib705 = na
var line lineFib788 = na
var line lineFib886 = na
var box boxLocation = na
var label labelFib705 = na
var label labelFib788 = na
var label labelFib886 = na

f_locationColor() =>
    locationDirection == LOC_LONG ? color.lime : locationDirection == LOC_SHORT ? color.red : color.silver

f_locationBorderColor() =>
    locationEligible and not locationInvalidated ? color.new(f_locationColor(), 25) : color.new(color.orange, 35)

f_locationFillColor() =>
    locationEligible and not locationInvalidated ? color.new(f_locationColor(), 91) : color.new(color.orange, 93)

f_updateTimedLevel(line id, int startTime, float price, color lineColor, string styleName, int widthValue) =>
    line result = id
    lineStyle = styleName == "dotted" ? line.style_dotted : styleName == "dashed" ? line.style_dashed : line.style_solid
    if not na(startTime) and not na(price)
        if na(result)
            result := line.new(startTime, price, time, price, xloc=xloc.bar_time, extend=extend.right, color=lineColor, style=lineStyle, width=widthValue)
        else
            line.set_xy1(result, startTime, price)
            line.set_xy2(result, time, price)
            line.set_extend(result, extend.right)
            line.set_color(result, lineColor)
            line.set_style(result, lineStyle)
            line.set_width(result, widthValue)
    result

f_updateLocationLabel(label id, float price, string txt, color textColor) =>
    label result = id
    if not na(price)
        if na(result)
            result := label.new(bar_index + 8, price, txt, xloc=xloc.bar_index, style=label.style_none, textcolor=textColor, size=size.tiny)
        else
            label.set_x(result, bar_index + 8)
            label.set_y(result, price)
            label.set_text(result, txt)
            label.set_textcolor(result, textColor)
    result

if barstate.islast
    bool drawLocation = showLocationZone and locationDirection != LOC_NONE and anchorLegValid and inTestWindow
    if drawLocation
        color locColor = f_locationColor()
        color borderColor = f_locationBorderColor()
        color fillColor = f_locationFillColor()

        lineFib705 := f_updateTimedLevel(lineFib705, anchorEndTime, fib705, color.new(locColor, 35), "solid", 1)
        lineFib788 := f_updateTimedLevel(lineFib788, anchorEndTime, fib788, color.new(locColor, 45), "dotted", 1)
        lineFib886 := f_updateTimedLevel(lineFib886, anchorEndTime, fib886, color.new(color.orange, 15), "solid", 1)

        if na(boxLocation)
            boxLocation := box.new(anchorEndTime, locationZoneTop, time, locationZoneBottom, xloc=xloc.bar_time, border_color=borderColor, border_width=1, bgcolor=fillColor)
        else
            box.set_left(boxLocation, anchorEndTime)
            box.set_right(boxLocation, time)
            box.set_top(boxLocation, locationZoneTop)
            box.set_bottom(boxLocation, locationZoneBottom)
            box.set_border_color(boxLocation, borderColor)
            box.set_bgcolor(boxLocation, fillColor)

        if showImpulseAnchor and not na(anchorStartTime) and not na(anchorStartPrice) and not na(anchorEndTime) and not na(anchorEndPrice)
            if na(lineImpulse)
                lineImpulse := line.new(anchorStartTime, anchorStartPrice, anchorEndTime, anchorEndPrice, xloc=xloc.bar_time, extend=extend.none, color=color.new(locColor, 55), style=line.style_dashed, width=1)
            else
                line.set_xy1(lineImpulse, anchorStartTime, anchorStartPrice)
                line.set_xy2(lineImpulse, anchorEndTime, anchorEndPrice)
                line.set_color(lineImpulse, color.new(locColor, 55))
        else if not na(lineImpulse)
            line.delete(lineImpulse)
            lineImpulse := na

        if showLocationLabels
            labelFib705 := f_updateLocationLabel(labelFib705, fib705, "LOC 0.705", color.new(locColor, 0))
            labelFib788 := f_updateLocationLabel(labelFib788, fib788, "LOC 0.788", color.new(locColor, 0))
            labelFib886 := f_updateLocationLabel(labelFib886, fib886, "LOC 0.886 · INVALID", color.orange)
        else
            if not na(labelFib705)
                label.delete(labelFib705)
                labelFib705 := na
            if not na(labelFib788)
                label.delete(labelFib788)
                labelFib788 := na
            if not na(labelFib886)
                label.delete(labelFib886)
                labelFib886 := na
    else
        if not na(lineFib705)
            line.delete(lineFib705)
            lineFib705 := na
        if not na(lineFib788)
            line.delete(lineFib788)
            lineFib788 := na
        if not na(lineFib886)
            line.delete(lineFib886)
            lineFib886 := na
        if not na(boxLocation)
            box.delete(boxLocation)
            boxLocation := na
        if not na(lineImpulse)
            line.delete(lineImpulse)
            lineImpulse := na
        if not na(labelFib705)
            label.delete(labelFib705)
            labelFib705 := na
        if not na(labelFib788)
            label.delete(labelFib788)
            labelFib788 := na
        if not na(labelFib886)
            label.delete(labelFib886)
            labelFib886 := na

// -----------------------------------------------------------------------------
// Dashboard helpers
// -----------------------------------------------------------------------------
f_price(float value) =>
    na(value) ? "n/a" : str.tostring(value, format.mintick)

f_rangeText(float swingHigh, float swingLow) =>
    f_price(swingHigh) + " / " + f_price(swingLow)

f_tfStatus(bool valid) =>
    valid ? "5M OK" : "WRONG TF"

f_sessionStatus() =>
    inNyActiveSession ? "ACTIVE" : "INACTIVE"

f_pct(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.0") + "%"

f_gexColor() =>
    not useGex ? color.silver : not gexConfigured ? color.red : gexRegimeInput == "Negative" ? color.orange : gexRegimeInput == "Positive" ? color.aqua : color.silver

f_locationBiasColor() =>
    locationDirection == LOC_LONG ? color.lime : locationDirection == LOC_SHORT ? color.red : color.silver

f_locationStateColor() =>
    str.contains(locationState, "IN LONG") ? color.lime :
     str.contains(locationState, "IN SHORT") ? color.red :
     str.contains(locationState, "APPROACHING") ? color.aqua :
     str.contains(locationState, "INVALID") or str.contains(locationState, "WRONG") or str.contains(locationState, "OVERLAPS") ? color.red :
     str.contains(locationState, "VALID") ? color.lime : color.silver

f_anchorText() =>
    anchorLegValid ? anchorSource + " · " + f_price(anchorStartPrice) + " → " + f_price(anchorEndPrice) : "n/a"

f_zoneText() =>
    anchorLegValid ? f_price(locationZoneTop) + " → " + f_price(locationZoneBottom) : "n/a"

f_impulseSideText() =>
    locationDirection == LOC_LONG ? "DISCOUNT" + (correctSideOfRange ? " ✓" : " ✕") : locationDirection == LOC_SHORT ? "PREMIUM" + (correctSideOfRange ? " ✓" : " ✕") : "n/a"

f_internalSwingText() =>
    not baseLegValid ? "n/a" : not requireInternalSwing ? (hasInternalSwing15m ? "15M FOUND · OPTIONAL" : "OPTIONAL") : hasInternalSwing15m ? "15M INTERNAL ✓" : "15M INTERNAL ✕"

f_valueSideColor() =>
    outsideValue ? color.lime : hasValueMap and anchorLegValid ? color.red : color.silver

f_compactMigrationText() =>
    valueMigration + " · " + migrationQuality + " · " + f_pct(valueOverlapPct)

f_compactGexText() =>
    not useGex ? "NOT CONFIGURED" : not gexConfigured ? gexInputStatus : gexRegime + " · " + gexVolatility + " · " + gammaFlipRelation

f_compactGexLevels() =>
    gexConfigured ? "F " + f_price(gammaFlip) + " | C " + f_price(callWall) + " | P " + f_price(putWall) : gexInputStatus

f_volumeText(float value) =>
    string result = "n/a"
    if not na(value)
        result := value >= 1000000 ? str.tostring(value / 1000000.0, "#.00") + "M" : value >= 1000 ? str.tostring(value / 1000.0, "#.0") + "K" : str.tostring(value, "#.0")
    result

f_ratioText(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.00") + "x"

f_participationText() =>
    string result = participationResolvedMode + " · " + participationState
    if inNyActiveSession
        if participationUsesAbsolute
            result := participationResolvedMode + " · " + f_volumeText(volume) + "/" + f_volumeText(absoluteVolumeThreshold) + " · " + participationState + (participationPass ? " ✓" : " ✕")
        else if participationState == "WARMING"
            result := participationResolvedMode + " · " + f_volumeText(volume) + " · " + str.tostring(participationBaselineSamples) + "/" + str.tostring(relativeMinSamples) + " · WARMING"
        else
            result := participationResolvedMode + " · " + f_volumeText(volume) + " · " + f_ratioText(participationRatio) + " · " + participationState + (participationPass ? " ✓" : " ✕")
    result

f_participationColor() =>
    participationState == "HIGH" ? color.lime :
     participationState == "NORMAL" ? color.aqua :
     participationState == "LOW" or participationState == "NO VOLUME" ? color.red :
     participationState == "WARMING" ? color.orange : color.silver

f_signedPct(float value) =>
    na(value) ? "n/a" : (value > 0 ? "+" : "") + str.tostring(value, "#.0") + "%"

f_orderflowAggressionText() =>
    string thresholdMode = aggressionBaselineReady ? "ADAPT" : "FIXED"
    orderflowProxySource + " · " + str.tostring(orderflowPositiveVolumeSamples) + "/" + str.tostring(orderflowLtfSamples) + " · Δ " + f_signedPct(orderflowDeltaPct) + " · T " + str.tostring(aggressionThresholdPct, "#.0") + "% " + thresholdMode + " · " + aggressionState

f_orderflowAggressionColor() =>
    not orderflowDataReady ? color.red : buyerAggression ? color.lime : sellerAggression ? color.red : str.contains(aggressionState, "BLOCKED") ? color.orange : color.silver

f_absorptionText() =>
    string metrics = aggressionDetected ? " · E " + str.tostring(math.abs(orderflowDeltaPct), "#.0") + "% / R " + str.tostring(activeDirectionalProgressPct, "#.0") + "% / W " + str.tostring(activeRejectionWickPct, "#.0") + "%" : ""
    absorptionState + metrics

f_absorptionColor() =>
    sellerAbsorption ? color.lime : buyerAbsorption ? color.red : potentialAbsorption ? color.orange : str.contains(absorptionState, "NO DATA") ? color.red : color.silver

f_dominanceText() =>
    string mode = dominanceDiagnosticMode ? "DIAG · " : dominanceTestMode ? "TEST · " : ""
    string criteria = dominanceDiagnosticMode ? " · T" + str.tostring(effectiveDominanceMinProgressPct, "#.0") + "/" + str.tostring(effectiveDominanceMinCloseLocationPct, "#.0") : ""
    string metrics = dominanceShiftDetected ? " · P " + str.tostring(buyerDominanceShift ? dominanceBuyerProgressPct : dominanceSellerProgressPct, "#.0") + "%" : dominancePendingNow ? " · mid " + f_price(pendingDominanceMid) : ""
    mode + dominanceState + criteria + metrics

f_dominanceColor() =>
    buyerDominanceShift ? color.lime : sellerDominanceShift ? color.red : dominancePendingNow ? color.orange : dominanceTestMode ? color.orange : color.silver

f_setupText() =>
    string mode = setupDiagnosticMode ? "DIAG · " : ""
    string extreme = setupPendingNow and not na(setupFailureExtreme) ? " · fail " + f_price(setupFailureExtreme) : ""
    mode + setupState + extreme

f_setupColor() =>
    setupReadyLong ? color.lime : setupReadyShort ? color.red : setupPendingNow ? color.orange : setupDiagnosticMode ? color.orange : color.silver

f_flowGateColor() =>
    flowGateReady ? color.lime : str.contains(orderflowState, "VOLUME") or str.contains(orderflowState, "OF DATA") ? color.red : str.contains(orderflowState, "POTENTIAL") or str.contains(orderflowState, "AGGRESSION") or str.contains(orderflowState, "SHIFT") ? color.orange : color.silver

f_planStatusColor() =>
    planInvalidationTouched ? color.red : planT3Touched ? color.lime : planT2Touched or planT1Touched ? color.aqua : planExists ? color.orange : color.silver

f_planRefText() =>
    not planExists ? "n/a" : f_planDirectionText() + " · Ref " + f_price(planEntryRef) + " · Inv " + f_price(planInvalidation)

f_planTargetsCompact() =>
    not planExists ? "n/a" : "T1 " + f_planTargetText(planT1Name, planT1, planT1Touched, planEntryRef, planInvalidation) + " | T2 " + f_planTargetText(planT2Name, planT2, planT2Touched, planEntryRef, planInvalidation) + " | T3 " + f_planTargetText(planT3Name, planT3, planT3Touched, planEntryRef, planInvalidation)

f_planQualityCompact() =>
    not planExists ? "WAIT" : planQuality + " · " + planQualityGate + " · Min " + str.tostring(minimumActionableR, "#.2") + "R"

f_modeText() =>
    productionMode ? "PRODUCTION" : validationMode ? "VALIDATION" : "DEBUG"

f_modeColor() =>
    productionMode ? color.lime : validationMode ? color.orange : color.aqua

f_htfCompact() =>
    "4H " + f_structureText(structure4h) + " | 1H " + f_structureText(structure1h) + " | " + structureEnvironment

f_locationCompact() =>
    f_locationBiasText() + (locationDirection != LOC_NONE ? " · " + f_impulseSideText() : "") + " | " + locationState

f_zoneValueCompact() =>
    f_zoneText() + " | " + valueSideText

f_aggressionCompact() =>
    aggressionState + (orderflowDataReady and not na(orderflowDeltaPct) ? " · Δ " + f_signedPct(orderflowDeltaPct) : "")

f_absDomCompact() =>
    absorptionState + " | " + dominanceState

f_setupCompact() =>
    setupState

// -----------------------------------------------------------------------------
// Dashboard
// -----------------------------------------------------------------------------
f_profileMode() =>
    string result = "WARMING"
    if inProfileSession
        result := currentCollectorSamples == 0 ? "WARMING" : currentPositiveVolumeSamples == 0 ? "NO VOLUME DATA" : "DEVELOPING"
    else
        result := lastAttemptSamples == 0 ? "WARMING" : lastAttemptPositiveVolumeSamples == 0 ? (not na(latestVah) ? "NO VOL · PRIOR MAP" : "NO VOLUME DATA") : not na(latestVah) ? "LAST CLOSED" : "PROFILE INVALID"
    result

f_volumeSource() =>
    int totalSamples = inProfileSession ? currentCollectorSamples : lastAttemptSamples
    int positiveSamples = inProfileSession ? currentPositiveVolumeSamples : lastAttemptPositiveVolumeSamples
    string source = positiveSamples > 0 ? (syminfo.type == "forex" ? "TICK / FEED VOL" : "FEED VOLUME") : "UNAVAILABLE"
    source + " · " + str.tostring(positiveSamples) + "/" + str.tostring(totalSamples)

f_envColor(string state) =>
    str.contains(state, "BULLISH") ? color.lime :
     str.contains(state, "BEARISH") ? color.red :
     str.contains(state, "TRANSITION") ? color.orange : color.silver

f_profileCompact() =>
    int totalSamples = inProfileSession ? currentCollectorSamples : lastAttemptSamples
    int positiveSamples = inProfileSession ? currentPositiveVolumeSamples : lastAttemptPositiveVolumeSamples
    f_profileMode() + " · " + str.tostring(positiveSamples) + "/" + str.tostring(totalSamples)

var table dash = table.new(position.top_right, 2, 21, bgcolor=color.new(color.black, 14), frame_color=color.new(color.gray, 58), frame_width=1, border_color=color.new(color.gray, 78), border_width=1)

if barstate.islast
    if showDashboard
        table.clear(dash, 0, 0, 1, 20)

        table.cell(dash, 0, 0, "WORLDCHAMP", text_color=color.white, text_size=size.small, bgcolor=color.new(color.silver, 82))
        table.cell(dash, 1, 0, "P9.3 · " + f_modeText(), text_color=f_modeColor(), text_size=size.small, bgcolor=color.new(color.silver, 82))

        table.cell(dash, 0, 1, "Chart / Session", text_size=size.tiny)
        table.cell(dash, 1, 1, f_tfStatus(isFiveMinute) + " · " + f_sessionStatus() + " · " + (useTestWindow ? str.tostring(testDays) + "D" : "FULL"), text_color=isFiveMinute ? (inNyActiveSession ? color.lime : color.silver) : color.red, text_size=size.tiny)

        table.cell(dash, 0, 2, "HTF", text_size=size.tiny)
        table.cell(dash, 1, 2, f_htfCompact(), text_color=f_alignmentColor(structure4h, structure1h), text_size=size.tiny)

        table.cell(dash, 0, 3, "Value", text_size=size.tiny)
        table.cell(dash, 1, 3, f_compactMigrationText() + " · " + f_profileCompact(), text_color=f_valueColor(valueMigration), text_size=size.tiny)

        table.cell(dash, 0, 4, "GEX", text_size=size.tiny)
        table.cell(dash, 1, 4, f_compactGexText(), text_color=f_gexColor(), text_size=size.tiny)

        table.cell(dash, 0, 5, "Environment", text_size=size.tiny)
        table.cell(dash, 1, 5, environmentState, text_color=f_envColor(environmentState), text_size=size.tiny)

        table.cell(dash, 0, 6, "LOCATION", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.silver, 84))
        table.cell(dash, 1, 6, locationTestOverride ? "TEST" : "AUTO", text_color=locationTestOverride ? color.orange : color.aqua, text_size=size.tiny, bgcolor=color.new(color.silver, 84))

        table.cell(dash, 0, 7, "Bias / State", text_size=size.tiny)
        table.cell(dash, 1, 7, f_locationCompact(), text_color=f_locationStateColor(), text_size=size.tiny)

        table.cell(dash, 0, 8, "Zone / Value", text_size=size.tiny)
        table.cell(dash, 1, 8, f_zoneValueCompact(), text_color=f_valueSideColor(), text_size=size.tiny)

        table.cell(dash, 0, 9, "Participation", text_size=size.tiny)
        table.cell(dash, 1, 9, f_participationText(), text_color=f_participationColor(), text_size=size.tiny)

        table.cell(dash, 0, 10, "ORDER FLOW", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.silver, 84))
        table.cell(dash, 1, 10, orderflowProxySource, text_color=color.aqua, text_size=size.tiny, bgcolor=color.new(color.silver, 84))

        table.cell(dash, 0, 11, "Aggression", text_size=size.tiny)
        table.cell(dash, 1, 11, f_aggressionCompact(), text_color=f_orderflowAggressionColor(), text_size=size.tiny)

        table.cell(dash, 0, 12, "Abs / Dominance", text_size=size.tiny)
        table.cell(dash, 1, 12, f_absDomCompact(), text_color=buyerDominanceShift or sellerAbsorption ? color.lime : sellerDominanceShift or buyerAbsorption ? color.red : potentialAbsorption or dominancePendingNow ? color.orange : color.silver, text_size=size.tiny)

        table.cell(dash, 0, 13, "Retest / Setup", text_size=size.tiny)
        table.cell(dash, 1, 13, f_setupCompact(), text_color=f_setupColor(), text_size=size.tiny)

        table.cell(dash, 0, 14, "Flow / Execution", text_size=size.tiny)
        table.cell(dash, 1, 14, orderflowState + " / MANUAL", text_color=f_flowGateColor(), text_size=size.tiny)

        table.cell(dash, 0, 15, "PLAN", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.silver, 84))
        table.cell(dash, 1, 15, planExists ? f_planDirectionText() : "WAIT", text_color=planExists ? color.aqua : color.silver, text_size=size.tiny, bgcolor=color.new(color.silver, 84))

        table.cell(dash, 0, 16, "Ready / Inv", text_size=size.tiny)
        table.cell(dash, 1, 16, f_planRefText(), text_color=planInvalidationTouched ? color.red : color.silver, text_size=size.tiny)

        table.cell(dash, 0, 17, "Targets", text_size=size.tiny)
        table.cell(dash, 1, 17, f_planTargetsCompact(), text_color=color.silver, text_size=size.tiny)

        table.cell(dash, 0, 18, "Quality / Status", text_size=size.tiny)
        table.cell(dash, 1, 18, f_planQualityCompact() + " | " + planStatus, text_color=planInvalidationTouched ? color.red : f_planQualityColor(planQuality), text_size=size.tiny)

        table.cell(dash, 0, 19, "Management", text_size=size.tiny)
        table.cell(dash, 1, 19, managementState, text_color=f_managementColor(), text_size=size.tiny)

        bool anyTestActive = locationTestOverride or dominanceTestMode or setupDiagnosticMode
        table.cell(dash, 0, 20, "State", text_size=size.tiny)
        table.cell(dash, 1, 20, masterState + (anyTestActive ? " · TEST" : ""), text_color=anyTestActive ? color.orange : color.aqua, text_size=size.tiny)
    else
        table.clear(dash, 0, 0, 1, 20)
