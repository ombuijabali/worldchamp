//@version=6
indicator("WorldChamp - Phase 0 Foundation", shorttitle="WorldChamp P0", overlay=true, max_lines_count=100, max_boxes_count=50, max_labels_count=100)

// =============================================================================
// PHASE 0 - FOUNDATION
// Manual execution only. No strategy orders are generated by this script.
// =============================================================================

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------
string WC_TZ = "America/New_York"
string TF_4H = "240"
string TF_1H = "60"
string TF_15M = "15"
int MS_DAY = 24 * 60 * 60 * 1000

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
string groupGeneral = "01 - General"
bool require5m = input.bool(true, "Require 5-minute chart", group=groupGeneral)
bool showDashboard = input.bool(true, "Show dashboard", group=groupGeneral)
bool debugMode = input.bool(false, "Debug mode", group=groupGeneral)

string groupTest = "02 - Development Window"
bool useTestWindow = input.bool(true, "Limit drawings to recent window", group=groupTest)
int testDays = input.int(7, "Calendar days", minval=1, maxval=60, group=groupTest)

string groupSession = "03 - New York Session"
string nyActiveSession = input.session("0930-1100", "Active trading window", group=groupSession)
bool shadeActiveSession = input.bool(true, "Shade active window", group=groupSession)

string groupDebug = "04 - Debug Visuals"
bool debugPlotHTF = input.bool(true, "Plot confirmed HTF closes", group=groupDebug)
bool debugPlotWindowStart = input.bool(false, "Mark test-window start", group=groupDebug)

// -----------------------------------------------------------------------------
// Chart guards
// -----------------------------------------------------------------------------
int chartSeconds = timeframe.in_seconds(timeframe.period)
int fiveMinSeconds = timeframe.in_seconds("5")
bool isFiveMinute = chartSeconds == fiveMinSeconds

if require5m and chartSeconds != fiveMinSeconds
    runtime.error("WorldChamp Phase 0 must run on a 5-minute chart while 'Require 5-minute chart' is enabled.")

// -----------------------------------------------------------------------------
// Development-window helper
// Uses timenow so the active test area follows the most recent chart date.
// -----------------------------------------------------------------------------
int windowStart = timenow - testDays * MS_DAY
bool inTestWindow = not useTestWindow or time >= windowStart

// -----------------------------------------------------------------------------
// Confirmed higher-timeframe OHLC
// TradingView's recommended non-repainting HTF pattern:
// expression[1] + barmerge.lookahead_on
// -----------------------------------------------------------------------------
[open4h, high4h, low4h, close4h, time4h] = request.security(
    syminfo.tickerid,
    TF_4H,
    [open[1], high[1], low[1], close[1], time[1]],
    lookahead=barmerge.lookahead_on)

[open1h, high1h, low1h, close1h, time1h] = request.security(
    syminfo.tickerid,
    TF_1H,
    [open[1], high[1], low[1], close[1], time[1]],
    lookahead=barmerge.lookahead_on)

[open15m, high15m, low15m, close15m, time15m] = request.security(
    syminfo.tickerid,
    TF_15M,
    [open[1], high[1], low[1], close[1], time[1]],
    lookahead=barmerge.lookahead_on)

// -----------------------------------------------------------------------------
// New York session engine
// IANA timezone handles DST automatically.
// -----------------------------------------------------------------------------
bool inNyActiveSession = not na(time(timeframe.period, nyActiveSession, WC_TZ))
bool nySessionStarted = inNyActiveSession and not inNyActiveSession[1]
bool nySessionEnded = not inNyActiveSession and inNyActiveSession[1]

// -----------------------------------------------------------------------------
// Phase-state placeholders
// These will be replaced by real logic in later phases.
// -----------------------------------------------------------------------------
string environmentState = "NOT BUILT"
string locationState = "NOT BUILT"
string orderflowState = "NOT BUILT"
string masterState = "FOUNDATION"

// -----------------------------------------------------------------------------
// Clean development visuals
// -----------------------------------------------------------------------------
color sessionShade = color.new(color.teal, 92)
bgcolor(shadeActiveSession and inTestWindow and inNyActiveSession ? sessionShade : na, title="NY active window")

plot(debugMode and debugPlotHTF and inTestWindow ? close4h : na, "Confirmed 4H close", color=color.new(color.blue, 35), linewidth=2, style=plot.style_stepline)
plot(debugMode and debugPlotHTF and inTestWindow ? close1h : na, "Confirmed 1H close", color=color.new(color.orange, 45), linewidth=1, style=plot.style_stepline)
plot(debugMode and debugPlotHTF and inTestWindow ? close15m : na, "Confirmed 15M close", color=color.new(color.gray, 55), linewidth=1, style=plot.style_stepline)

plotshape(debugMode and inTestWindow and nySessionStarted, title="NY window start", style=shape.circle, location=location.bottom, size=size.tiny, color=color.new(color.green, 0), text="NY")
plotshape(debugMode and inTestWindow and nySessionEnded, title="NY window end", style=shape.circle, location=location.bottom, size=size.tiny, color=color.new(color.red, 0), text="END")
plotshape(debugMode and debugPlotWindowStart and useTestWindow and time >= windowStart and time[1] < windowStart, title="Test window start", style=shape.flag, location=location.top, size=size.tiny, color=color.new(color.yellow, 0), text="7D")

// -----------------------------------------------------------------------------
// Dashboard helpers
// -----------------------------------------------------------------------------
f_yesNo(bool value) =>
    value ? "YES" : "NO"

f_price(float value) =>
    na(value) ? "n/a" : str.tostring(value, format.mintick)

f_tfStatus(bool valid) =>
    valid ? "5M OK" : "WRONG TF"

f_sessionStatus() =>
    inNyActiveSession ? "ACTIVE" : "INACTIVE"

// -----------------------------------------------------------------------------
// Dashboard
// -----------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 12), frame_color=color.new(color.gray, 55), frame_width=1, border_color=color.new(color.gray, 75), border_width=1)

if barstate.islast
    if showDashboard
        table.cell(dash, 0, 0, "WORLDCHAMP", text_color=color.white, text_size=size.small, bgcolor=color.new(color.silver, 82))
        table.cell(dash, 1, 0, "PHASE 0", text_color=color.white, text_size=size.small, bgcolor=color.new(color.silver, 82))

        table.cell(dash, 0, 1, "Chart")
        table.cell(dash, 1, 1, f_tfStatus(isFiveMinute), text_color=isFiveMinute ? color.lime : color.red)

        table.cell(dash, 0, 2, "7D Test")
        table.cell(dash, 1, 2, useTestWindow ? "ON (" + str.tostring(testDays) + "d)" : "OFF")

        table.cell(dash, 0, 3, "NY Window")
        table.cell(dash, 1, 3, f_sessionStatus(), text_color=inNyActiveSession ? color.lime : color.silver)

        table.cell(dash, 0, 4, "4H confirmed C")
        table.cell(dash, 1, 4, f_price(close4h))

        table.cell(dash, 0, 5, "1H confirmed C")
        table.cell(dash, 1, 5, f_price(close1h))

        table.cell(dash, 0, 6, "15M confirmed C")
        table.cell(dash, 1, 6, f_price(close15m))

        table.cell(dash, 0, 7, "Environment")
        table.cell(dash, 1, 7, environmentState, text_color=color.silver)

        table.cell(dash, 0, 8, "Location")
        table.cell(dash, 1, 8, locationState, text_color=color.silver)

        table.cell(dash, 0, 9, "Order Flow")
        table.cell(dash, 1, 9, orderflowState, text_color=color.silver)

        table.cell(dash, 0, 10, "State")
        table.cell(dash, 1, 10, masterState, text_color=color.aqua)
    else
        table.clear(dash, 0, 0, 1, 10)
